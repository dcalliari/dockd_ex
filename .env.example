# Desenvolvimento local com docker compose
POSTGRES_USER=dockd
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dockd_dev
APP_PORT=4000

# Optional IGDB catalog synchronization
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
IGDB_SYNC_INTERVAL_MS=86400000

# Overlay de proxy com banco externo
PHX_HOST=dockd.localhost
DATABASE_URL=ecto://dockd:change-me@postgres.example:5432/dockd_prod
SECRET_KEY_BASE=generate-with-mix-phx-gen-secret
TRAEFIK_NETWORK=shared_network
TRAEFIK_ENTRYPOINT=websecure
