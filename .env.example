# Desenvolvimento local com docker compose
POSTGRES_USER=dockd
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dockd_dev
APP_PORT=4000

# Optional IGDB catalog synchronization
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
IGDB_SYNC_INTERVAL_MS=86400000

# Precos da eShop Brasil, opcional, na mesma sincronizacao diaria do IGDB.
# A chave e a de busca (search-only) que o nintendo.com entrega a todo navegador:
# procure appId:"U3B6GR4UA3",appKey:"..." no bundle _app-*.js do site. Nunca a
# commite. Sem ela o Dockd nao casa jogos novos, mas atualiza os ja casados.
ESHOP_ALGOLIA_SEARCH_KEY=
# ESHOP_ALGOLIA_APP_ID=U3B6GR4UA3

# E-mail por SMTP, opcional. Sem SMTP_HOST a tela Entrar oferece so e-mail e senha;
# com ele, tambem o link de entrada. Porta 465 usa TLS direto; as demais, STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Overlay de proxy com banco externo
PHX_HOST=dockd.localhost
DATABASE_URL=ecto://dockd:change-me@postgres.example:5432/dockd_prod
SECRET_KEY_BASE=generate-with-mix-phx-gen-secret
TRAEFIK_NETWORK=shared_network
TRAEFIK_ENTRYPOINT=websecure
