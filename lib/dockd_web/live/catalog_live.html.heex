<Layouts.app flash={@flash} current="Catálogo">
  <div class="space-y-8">
    <.page_header title="Catálogo" />
    <div
      id="games-list"
      class="grid grid-cols-2 gap-x-4 gap-y-9 sm:grid-cols-3 lg:grid-cols-5 xl:grid-cols-6"
    >
      <%= for game <- @games do %>
        <article id={"game-#{game.id}"} class="group min-w-0">
          <.link navigate={~p"/jogos/#{game.id}"} class="block">
            <.game_cover title={game.title} cover_url={game.cover_url} />
            <span class="dockd-game-title">{game.title}</span>
            <span class="dockd-meta mt-1 block truncate">{enum_label(game.availability)}</span>
          </.link>
          <%= if MapSet.member?(@library_game_ids, game.id) do %>
            <p class="dockd-meta mt-2">Na biblioteca</p>
          <% else %>
            <button
              id={"add-library-#{game.id}"}
              class="dockd-button dockd-button-quiet mt-2 w-full"
              phx-click="add_to_library"
              phx-value-id={game.id}
            >Adicionar</button>
          <% end %>
        </article>
      <% end %>
      <div :if={@games == []} class="col-span-full"><.empty_state title="Catálogo vazio" /></div>
    </div>
  </div>
</Layouts.app>
