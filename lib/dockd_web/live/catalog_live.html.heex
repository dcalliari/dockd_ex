<Layouts.app flash={@flash} current="Catálogo">
  <div class="space-y-8">
    <.page_header title="Catálogo" />
    <div
      id="games-list"
      class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5"
    >
      <%= for game <- @games do %>
        <article id={"game-#{game.id}"} class="group min-w-0">
          <.link navigate={~p"/jogos/#{game.id}"} class="block">
            <.game_cover
              title={game.title}
              cover_url={game.cover_url}
              class="transition duration-200 group-hover:-translate-y-1 group-hover:shadow-xl"
            />
            <h2 class="mt-3 truncate font-bold">{game.title}</h2>
            <p class="mt-1 truncate text-xs text-base-content/55">
              {enum_label(game.availability)}
            </p>
          </.link>
          <button
            id={"add-library-#{game.id}"}
            class="btn btn-sm btn-ghost mt-2 px-0 text-primary"
            phx-click="add_to_library"
            phx-value-id={game.id}
          >+ Biblioteca</button>
        </article>
      <% end %>
      <div :if={@games == []} class="col-span-full"><.empty_state title="Catálogo vazio" /></div>
    </div>
  </div>
</Layouts.app>
