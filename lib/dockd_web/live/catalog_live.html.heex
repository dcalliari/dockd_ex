<Layouts.app flash={@flash} current="Descobrir">
  <div class="space-y-7">
    <.page_header title="Descobrir">
      <:actions>
        <.link navigate="/biblioteca" class="text-xs font-bold text-primary">Biblioteca</.link>
      </:actions>
    </.page_header>

    <.form for={@search_form} id="catalog-search-form" phx-change="search" class="max-w-md">
      <.input
        field={@search_form[:search]}
        id="catalog-search"
        label="Buscar"
        placeholder="Título"
        value={@search}
        phx-debounce="250"
      />
    </.form>

    <div
      id="games-list"
      class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5"
    >
      <%= for game <- @games do %>
        <article id={"game-#{game.id}"} class="catalog-card group min-w-0">
          <.link navigate={"/jogos/#{game.id}?from=catalog"} class="block">
            <.game_cover
              title={game.title}
              cover_url={game.cover_url}
              class="transition duration-200 group-hover:-translate-y-1 group-hover:shadow-xl"
            />
            <h2 class="mt-3 truncate font-bold">{game.title}</h2>
            <p class="mt-1 truncate text-xs text-base-content/55">{platform_label(game)}</p>
          </.link>
          <%= if relation_label(game, @entries_by_game, @owned_game_ids) do %>
            <span class="mt-2 block text-xs font-semibold text-base-content/55">
              {relation_label(game, @entries_by_game, @owned_game_ids)}
            </span>
          <% else %>
            <button
              id={"add-library-#{game.id}"}
              class="mt-2 text-xs font-bold text-primary hover:underline"
              phx-click="add_to_library"
              phx-value-id={game.id}
            >Adicionar à lista</button>
          <% end %>
        </article>
      <% end %>
      <div :if={@games == []} class="col-span-full py-10 text-center text-sm text-base-content/60">
        Nenhum jogo
      </div>
    </div>
  </div>
</Layouts.app>
