<Layouts.app flash={@flash} current="Descobrir">
  <div id="catalog">
    <.page_header title="Descobrir" subtitle="Encontre seu próximo jogo.">
      <:actions><.link navigate="/biblioteca" class="link-action">Biblioteca</.link></:actions>
    </.page_header>

    <div class="catalog-toolbar">
      <.form
        for={@search_form}
        id="catalog-search-form"
        phx-change="search"
        class="w-full max-w-sm"
      >
        <.input
          field={@search_form[:search]}
          id="catalog-search"
          label="Buscar"
          placeholder="Título"
          value={@search}
          class="search-field"
          phx-debounce="250"
        />
      </.form>
      <div class="catalog-filter" aria-label="Plataforma">
        <button class="active" type="button">Todos</button>
        <button type="button">Switch</button>
        <button type="button">Switch 2</button>
      </div>
    </div>

    <div id="games-list" class="catalog-grid">
      <%= for game <- @games do %>
        <article id={"game-#{game.id}"} class="catalog-card group">
          <.link navigate={"/jogos/#{game.id}?from=catalog"}>
            <.game_cover title={game.title} cover_url={game.cover_url} />
            <h2>{game.title}</h2>
            <p>{platform_label(game)}</p>
          </.link>
          <%= if relation_label(game, @entries_by_game, @owned_game_ids) do %>
            <span class="mt-2 block text-xs font-semibold text-base-content/55">
              {relation_label(game, @entries_by_game, @owned_game_ids)}
            </span>
          <% else %>
            <button
              id={"add-library-#{game.id}"}
              phx-click="add_to_library"
              phx-value-id={game.id}
            >Adicionar à lista</button>
          <% end %>
        </article>
      <% end %>
      <div :if={@games == []} class="col-span-full library-empty">
        <strong>Nenhum jogo</strong>
        <p>Altere a busca para continuar.</p>
      </div>
    </div>
  </div>
</Layouts.app>
