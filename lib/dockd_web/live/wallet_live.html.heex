<Layouts.app flash={@flash} current="Carteira">
  <div class="mx-auto max-w-4xl space-y-8">
    <.page_header title="Carteira" />
    <section id="balance-section">
      <.section_card title="Saldo eShop">
        <div class="flex items-center justify-between gap-4">
          <p class="text-4xl font-black tabular-nums">
            {money(@balance.amount_cents || 0, "BRL")}
          </p>
          <details>
            <summary class="btn btn-ghost btn-sm cursor-pointer">Editar saldo</summary>
            <.form
              for={@balance_form}
              id="balance-form"
              phx-submit="save-balance"
              class="mt-4 space-y-4"
            >
              <.money_input field={@balance_form[:amount_cents]} label="Saldo (R$)" />
              <input type="hidden" name="store_balance[currency]" value="BRL" />
              <button id="save-balance-button" class="btn btn-primary" type="submit">Salvar saldo</button>
            </.form>
          </details>
        </div>
      </.section_card>
    </section>
    <section id="reservations-section">
      <.section_card title="Reservas para lançamentos">
        <div id="reservations-list" class="divide-y divide-base-content/10">
          <%= for reservation <- @reservations do %>
            <details id={"reservation-#{reservation.id}"} class="group py-4">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-3">
                <span><strong class="block">{reservation.game.title}</strong><small class="text-base-content/60">{money(
                  reservation.amount_cents,
                  "BRL"
                )}</small></span>
                <span class="text-sm text-base-content/50">Ver detalhes</span>
              </summary>
              <div class="mt-4 rounded-lg bg-base-200 p-4">
                <.form
                  for={@reservation_form}
                  id={"reservation-form-#{reservation.id}"}
                  phx-submit="save-reservation"
                  class="grid gap-3"
                >
                  <input type="hidden" name="balance_reservation[id]" value={reservation.id} />
                  <.input
                    id={"reservation-game-#{reservation.id}"}
                    field={@reservation_form[:game_id]}
                    type="select"
                    label="Jogo"
                    options={Enum.map(@games, &{&1.title, &1.id})}
                    value={reservation.game_id}
                  />
                  <.money_input
                    id={"reservation-amount-#{reservation.id}"}
                    field={@reservation_form[:amount_cents]}
                    label="Valor (R$)"
                  />
                  <.input
                    id={"reservation-note-#{reservation.id}"}
                    field={@reservation_form[:note]}
                    label="Observação"
                  />
                  <button class="btn btn-primary" type="submit">Salvar reserva</button>
                </.form>
                <button
                  id={"delete-reservation-#{reservation.id}"}
                  class="btn btn-ghost mt-2 text-error"
                  phx-click="delete-reservation"
                  phx-value-id={reservation.id}
                  data-confirm="Excluir esta reserva?"
                >Excluir reserva</button>
              </div>
            </details>
          <% end %>
          <.empty_state :if={@reservations == []} title="Nenhuma reserva" />
        </div>
        <details id="new-reservation" class="mt-5">
          <summary id="new-reservation-button" class="btn btn-outline btn-primary cursor-pointer">
            Nova reserva
          </summary>
          <.form
            for={@reservation_form}
            id="reservation-form"
            phx-submit="save-reservation"
            class="mt-5 grid gap-4"
          >
            <.input
              id="new-reservation-game"
              field={@reservation_form[:game_id]}
              type="select"
              label="Jogo"
              options={Enum.map(@games, &{&1.title, &1.id})}
              prompt="Selecione um jogo"
            />
            <.money_input
              id="new-reservation-amount"
              field={@reservation_form[:amount_cents]}
              label="Valor (R$)"
            />
            <.input
              id="new-reservation-note"
              field={@reservation_form[:note]}
              label="Observação"
            />
            <button id="save-reservation-button" class="btn btn-primary" type="submit">Salvar reserva</button>
          </.form>
        </details>
      </.section_card>
    </section>
  </div>
</Layouts.app>
