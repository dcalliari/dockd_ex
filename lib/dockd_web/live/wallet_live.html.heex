<Layouts.app flash={@flash} current="Carteira">
  <div id="wallet">
    <.page_header title="Carteira" subtitle="Saldo e reservas.">
      <:actions><.link navigate="/" class="link-action">Planejador</.link></:actions>
    </.page_header>

    <section id="balance-section">
      <%= if @balance_exists? do %>
        <div class="wallet-summary">
          <div class="wallet-balance">
            <label>Saldo eShop</label>
            <strong>{money(@balance.amount_cents, @balance.currency)}</strong>
            <p :if={@balance.updated_at}>
              Atualizado {date_pt_br(DateTime.to_date(@balance.updated_at))}
            </p>
          </div>
          <div class="wallet-edit">
            <strong>{if @reserved_cents > @balance.amount_cents,
              do: "Livre negativo",
              else: "Livre disponível"}</strong>
            <p>{money(@reserved_cents, @balance.currency)} em reservas.</p>
            <details>
              <summary class="dockd-button dockd-button-secondary">Editar saldo</summary>
              <.form
                for={@balance_form}
                id="balance-form"
                phx-submit="save-balance"
                class="mt-3 max-w-sm space-y-3"
              >
                <.money_input field={@balance_form[:amount_cents]} label="Saldo (R$)" />
                <input type="hidden" name="store_balance[currency]" value="BRL" />
                <.dockd_button id="save-balance-button" variant="primary" type="submit">Salvar</.dockd_button>
              </.form>
            </details>
          </div>
        </div>
      <% else %>
        <div class="wallet-empty">
          <div>
            <strong>Saldo eShop</strong><p>Não informado</p>
          </div>
          <details>
            <summary class="dockd-button dockd-button-primary">Informar saldo</summary>
            <.form
              for={@balance_form}
              id="balance-form"
              phx-submit="save-balance"
              class="mt-3 max-w-sm space-y-3"
            >
              <.money_input field={@balance_form[:amount_cents]} label="Saldo (R$)" />
              <input type="hidden" name="store_balance[currency]" value="BRL" />
              <.dockd_button id="save-balance-button" variant="primary" type="submit">Salvar</.dockd_button>
            </.form>
          </details>
        </div>
      <% end %>
    </section>

    <section id="reservations-section">
      <.section_title
        title="Reservas"
        meta={"#{length(@reservations)} · #{money(@reserved_cents, @balance.currency)}"}
      />
      <div id="reservations-list" class="reservation-list">
        <%= for reservation <- @reservations do %>
          <details id={"reservation-#{reservation.id}"}>
            <summary class="reservation-row cursor-pointer list-none">
              <span>
                <strong>{reservation.game.title}</strong>
                <span>{money(reservation.amount_cents, @balance.currency)}</span>
              </span>
              <b>{money(reservation.amount_cents, @balance.currency)}</b>
              <span class="link-action">Editar</span>
            </summary>
            <div class="mt-3 rounded bg-base-200 p-3">
              <.form
                for={@reservation_form}
                id={"reservation-form-#{reservation.id}"}
                phx-submit="save-reservation"
                class="grid gap-3"
              >
                <input type="hidden" name="balance_reservation[id]" value={reservation.id} />
                <.input
                  id={"reservation-game-#{reservation.id}"}
                  field={@reservation_form[:game_id]}
                  type="select"
                  label="Jogo"
                  options={Enum.map(@games, &{&1.title, &1.id})}
                  value={reservation.game_id}
                />
                <.money_input
                  id={"reservation-amount-#{reservation.id}"}
                  field={@reservation_form[:amount_cents]}
                  label="Valor (R$)"
                />
                <.input
                  id={"reservation-note-#{reservation.id}"}
                  field={@reservation_form[:note]}
                  label="Observação"
                />
                <.dockd_button variant="primary" type="submit">Salvar</.dockd_button>
              </.form>
              <button
                id={"delete-reservation-#{reservation.id}"}
                class="mt-2 text-sm font-semibold text-error"
                phx-click="delete-reservation"
                phx-value-id={reservation.id}
                data-confirm="Excluir esta reserva?"
              >Excluir</button>
            </div>
          </details>
        <% end %>
        <div :if={@reservations == []} class="empty-row">
          <strong>Nenhuma reserva</strong>
          <p>Reserve um lançamento para vê-lo no planejador.</p>
        </div>
      </div>
      <details id="new-reservation" class="mt-5">
        <summary id="new-reservation-button" class="dockd-button dockd-button-secondary">
          Nova reserva
        </summary>
        <.form
          for={@reservation_form}
          id="reservation-form"
          phx-submit="save-reservation"
          class="mt-3 grid gap-3 rounded bg-base-200 p-3"
        >
          <.input
            id="new-reservation-game"
            field={@reservation_form[:game_id]}
            type="select"
            label="Jogo"
            options={Enum.map(@games, &{&1.title, &1.id})}
            prompt="Selecione um jogo"
          />
          <.money_input
            id="new-reservation-amount"
            field={@reservation_form[:amount_cents]}
            label="Valor (R$)"
          />
          <.input id="new-reservation-note" field={@reservation_form[:note]} label="Observação" />
          <.dockd_button id="save-reservation-button" variant="primary" type="submit">Salvar</.dockd_button>
        </.form>
      </details>
      <div class="wallet-footer">
        <p>Reservas afetam o livre do planejador.</p>
        <.link navigate="/" class="dockd-button dockd-button-primary">Ver impacto</.link>
      </div>
    </section>
  </div>
</Layouts.app>
