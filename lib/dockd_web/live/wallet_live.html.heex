<Layouts.app flash={@flash} current="Carteira">
  <div class="mx-auto max-w-4xl space-y-8">
    <.page_header title="Carteira" />

    <section id="balance-section" class="wallet-page-balance">
      <div class="flex flex-wrap items-end justify-between gap-5">
        <%= if @balance_exists? do %>
          <div>
            <span class="block text-xs font-bold uppercase tracking-widest text-base-content/50">Saldo</span>
            <strong class="mt-2 block text-4xl font-black tabular-nums sm:text-5xl">
              {money(@balance.amount_cents, @balance.currency)}
            </strong>
            <span :if={@balance.updated_at} class="mt-2 block text-xs text-base-content/55">
              Atualizado {date_pt_br(DateTime.to_date(@balance.updated_at))}
            </span>
          </div>
          <details>
            <summary class="btn btn-ghost btn-sm cursor-pointer">Editar</summary>
            <.form
              for={@balance_form}
              id="balance-form"
              phx-submit="save-balance"
              class="mt-4 min-w-64 space-y-4"
            >
              <.money_input field={@balance_form[:amount_cents]} label="Saldo (R$)" />
              <input type="hidden" name="store_balance[currency]" value="BRL" />
              <button id="save-balance-button" class="btn btn-primary" type="submit">Salvar</button>
            </.form>
          </details>
        <% else %>
          <details>
            <summary class="btn btn-primary cursor-pointer">Informar saldo</summary>
            <.form
              for={@balance_form}
              id="balance-form"
              phx-submit="save-balance"
              class="mt-4 max-w-sm space-y-4"
            >
              <.money_input field={@balance_form[:amount_cents]} label="Saldo (R$)" />
              <input type="hidden" name="store_balance[currency]" value="BRL" />
              <button id="save-balance-button" class="btn btn-primary" type="submit">Salvar</button>
            </.form>
          </details>
        <% end %>
      </div>
      <div :if={@balance_exists?} class="wallet-equation mt-7">
        <span><small>Saldo</small><strong>{money(@balance.amount_cents, @balance.currency)}</strong></span>
        <b aria-hidden="true">−</b>
        <span><small>Reservado</small><strong>{money(@reserved_cents, @balance.currency)}</strong></span>
        <b aria-hidden="true">=</b>
        <span class="text-primary"><small>Livre</small><strong>{money(
          @balance.amount_cents - @reserved_cents,
          @balance.currency
        )}</strong></span>
      </div>
    </section>

    <section id="reservations-section">
      <div class="flex items-end justify-between gap-3 border-b border-base-content/10 pb-3">
        <h2 class="text-lg font-bold">Reservas</h2>
        <span class="text-xs text-base-content/55">{length(@reservations)} · {money(
          @reserved_cents,
          @balance.currency
        )}</span>
      </div>
      <div id="reservations-list" class="divide-y divide-base-content/10">
        <%= for reservation <- @reservations do %>
          <details id={"reservation-#{reservation.id}"} class="group py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3">
              <span>
                <strong class="block">{reservation.game.title}</strong>
                <small class="mt-1 block text-xs text-base-content/55">{money(
                  reservation.amount_cents,
                  @balance.currency
                )}</small>
              </span>
              <span class="text-xs font-semibold text-primary">Editar</span>
            </summary>
            <div class="mt-4 rounded-xl bg-base-200 p-4">
              <.form
                for={@reservation_form}
                id={"reservation-form-#{reservation.id}"}
                phx-submit="save-reservation"
                class="grid gap-3"
              >
                <input type="hidden" name="balance_reservation[id]" value={reservation.id} />
                <.input
                  id={"reservation-game-#{reservation.id}"}
                  field={@reservation_form[:game_id]}
                  type="select"
                  label="Jogo"
                  options={Enum.map(@games, &{&1.title, &1.id})}
                  value={reservation.game_id}
                />
                <.money_input
                  id={"reservation-amount-#{reservation.id}"}
                  field={@reservation_form[:amount_cents]}
                  label="Valor (R$)"
                />
                <.input
                  id={"reservation-note-#{reservation.id}"}
                  field={@reservation_form[:note]}
                  label="Observação"
                />
                <button class="btn btn-primary" type="submit">Salvar</button>
              </.form>
              <button
                id={"delete-reservation-#{reservation.id}"}
                class="mt-2 text-sm font-semibold text-error"
                phx-click="delete-reservation"
                phx-value-id={reservation.id}
                data-confirm="Excluir esta reserva?"
              >Excluir</button>
            </div>
          </details>
        <% end %>
        <div :if={@reservations == []} class="py-5 text-sm text-base-content/60">
          Sem reservas
        </div>
      </div>
      <details id="new-reservation" class="mt-5">
        <summary id="new-reservation-button" class="btn btn-outline btn-primary cursor-pointer">
          Nova reserva
        </summary>
        <.form
          for={@reservation_form}
          id="reservation-form"
          phx-submit="save-reservation"
          class="mt-5 grid gap-4 rounded-xl bg-base-200 p-4"
        >
          <.input
            id="new-reservation-game"
            field={@reservation_form[:game_id]}
            type="select"
            label="Jogo"
            options={Enum.map(@games, &{&1.title, &1.id})}
            prompt="Selecione um jogo"
          />
          <.money_input
            id="new-reservation-amount"
            field={@reservation_form[:amount_cents]}
            label="Valor (R$)"
          />
          <.input id="new-reservation-note" field={@reservation_form[:note]} label="Observação" />
          <button id="save-reservation-button" class="btn btn-primary" type="submit">Salvar</button>
        </.form>
      </details>
    </section>
  </div>
</Layouts.app>
