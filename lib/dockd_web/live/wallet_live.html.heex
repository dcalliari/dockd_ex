<Layouts.app flash={@flash} current="Carteira">
  <div class="mx-auto max-w-4xl space-y-10">
    <.page_header title="Carteira" />

    <section id="balance-section" class="dockd-section">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="dockd-section-title">Crédito eShop</h2>
          <%= if is_integer(@balance.amount_cents) do %>
            <p class="dockd-value mt-3 text-3xl font-bold">
              {money(@balance.amount_cents, "BRL")}
            </p>
          <% else %>
            <p class="dockd-note mt-3">Saldo não informado</p>
          <% end %>
        </div>
        <details>
          <summary class="dockd-button dockd-button-quiet cursor-pointer">Editar saldo</summary>
          <.form
            for={@balance_form}
            id="balance-form"
            phx-submit="save-balance"
            class="mt-4 min-w-64 space-y-4"
          >
            <.money_input field={@balance_form[:amount_cents]} label="Saldo (R$)" />
            <input type="hidden" name="store_balance[currency]" value="BRL" />
            <button
              id="save-balance-button"
              class="dockd-button dockd-button-primary w-full"
              type="submit"
            >Salvar saldo</button>
          </.form>
        </details>
      </div>
    </section>

    <section id="reservations-section" class="dockd-section">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="dockd-section-title">Reservas</h2>
        <details id="new-reservation">
          <summary
            id="new-reservation-button"
            class="dockd-button dockd-button-primary cursor-pointer"
          >
            Nova reserva
          </summary>
          <.form
            for={@reservation_form}
            id="reservation-form"
            phx-submit="save-reservation"
            class="mt-4 grid gap-4 sm:min-w-96"
          >
            <.input
              id="new-reservation-game"
              field={@reservation_form[:game_id]}
              type="select"
              label="Jogo"
              options={Enum.map(@games, &{&1.title, &1.id})}
              prompt="Selecione um jogo"
            />
            <.money_input
              id="new-reservation-amount"
              field={@reservation_form[:amount_cents]}
              label="Valor (R$)"
            />
            <.input
              id="new-reservation-note"
              field={@reservation_form[:note]}
              label="Observação"
            />
            <button
              id="save-reservation-button"
              class="dockd-button dockd-button-primary"
              type="submit"
            >Salvar reserva</button>
          </.form>
        </details>
      </div>

      <div id="reservations-list" class="mt-5 divide-y divide-base-content/10">
        <%= for reservation <- @reservations do %>
          <details id={"reservation-#{reservation.id}"} class="group py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3">
              <span>
                <strong class="block">{reservation.game.title}</strong>
                <small class="dockd-value dockd-meta">{money(reservation.amount_cents, "BRL")}</small>
              </span>
              <span class="dockd-meta">Editar</span>
            </summary>
            <div class="mt-4 border-l-2 border-primary pl-4">
              <.form
                for={@reservation_form}
                id={"reservation-form-#{reservation.id}"}
                phx-submit="save-reservation"
                class="grid gap-3"
              >
                <input type="hidden" name="balance_reservation[id]" value={reservation.id} />
                <.input
                  id={"reservation-game-#{reservation.id}"}
                  field={@reservation_form[:game_id]}
                  type="select"
                  label="Jogo"
                  options={Enum.map(@games, &{&1.title, &1.id})}
                  value={reservation.game_id}
                />
                <.money_input
                  id={"reservation-amount-#{reservation.id}"}
                  field={@reservation_form[:amount_cents]}
                  label="Valor (R$)"
                />
                <.input
                  id={"reservation-note-#{reservation.id}"}
                  field={@reservation_form[:note]}
                  label="Observação"
                />
                <button class="dockd-button dockd-button-primary" type="submit">Salvar reserva</button>
              </.form>
              <button
                id={"delete-reservation-#{reservation.id}"}
                class="dockd-button dockd-button-danger mt-2"
                phx-click="delete-reservation"
                phx-value-id={reservation.id}
                data-confirm="Excluir esta reserva?"
              >Excluir reserva</button>
            </div>
          </details>
        <% end %>
        <.empty_state :if={@reservations == []} title="Nenhuma reserva" />
      </div>
    </section>
  </div>
</Layouts.app>
