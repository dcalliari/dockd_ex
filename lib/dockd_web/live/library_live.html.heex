<Layouts.app flash={@flash} current="Biblioteca">
  <div class="space-y-8">
    <.page_header title="Biblioteca">
      <:actions><a href="#add-game" class="btn btn-primary min-h-11">Adicionar jogo</a></:actions>
    </.page_header>

    <nav
      id="library-tabs"
      class="flex gap-1 overflow-x-auto border-b border-base-content/10"
      aria-label="Seções da biblioteca"
    >
      <%= for {label, key, count} <- [{"Jogando", "playing", Enum.count(@entries, &(&1.play_state == :playing))}, {"Backlog", "backlog", Enum.count(@entries, &(&1.backlog == :backlog))}, {"Quero", "want", Enum.count(@entries, &(&1.purchase_intent in [:want, :planned, :preordered]))}, {"Coleção", "all", length(@entries)}, {"Terminados", "finished", Enum.count(@entries, &(&1.play_state == :finished))}] do %>
        <button
          class={[
            "whitespace-nowrap border-b-2 px-3 py-3 text-sm font-semibold",
            @filters["tab"] == key && "border-primary text-primary",
            @filters["tab"] != key && "border-transparent text-base-content/70"
          ]}
          phx-click="filter"
          phx-value-tab={key}
        >
          {label} <span class="ml-1 text-xs opacity-80">{count}</span>
        </button>
      <% end %>
    </nav>

    <.form
      for={to_form(@filters, as: :filters)}
      id="library-filter-form"
      phx-change="filter"
      class="grid gap-3 sm:grid-cols-3"
    >
      <.input
        field={to_form(@filters, as: :filters)[:search]}
        name="search"
        label="Buscar"
        value={@filters["search"] || ""}
      />
      <.input
        field={to_form(@filters, as: :filters)[:backlog]}
        name="backlog"
        type="select"
        label="Backlog"
        options={[{"Todos", ""}, {"Backlog", "backlog"}, {"Ativo", "active"}, {"Fora", "no"}]}
        value={@filters["backlog"] || ""}
      />
      <.input
        field={to_form(@filters, as: :filters)[:play_state]}
        name="play_state"
        type="select"
        label="Estado"
        options={[
          {"Todos", ""},
          {"Jogando", "playing"},
          {"Não iniciado", "unplayed"},
          {"Terminado", "finished"},
          {"Abandonado", "abandoned"}
        ]}
        value={@filters["play_state"] || ""}
      />
    </.form>

    <div
      id="library-groups"
      class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5"
    >
      <%= for {group, entries} <- @groups do %>
        <%= for entry <- entries do %>
          <button
            id={"entry-#{entry.id}"}
            class="group min-w-0 text-left"
            phx-click="edit_entry"
            phx-value-id={entry.id}
          >
            <div class="relative">
              <.game_cover
                title={entry.game.title}
                cover_url={entry.game.cover_url}
                class="transition duration-200 group-hover:-translate-y-1 group-hover:shadow-xl"
              />
              <span
                :if={status_label(entry)}
                class="absolute left-2 top-2 rounded-md bg-base-100/90 px-2 py-1 text-[11px] font-semibold shadow-sm"
              >{status_label(entry)}</span>
            </div>
            <h2 class="mt-3 truncate font-bold">{entry.game.title}</h2>
            <p :if={platform_label(entry.game)} class="mt-1 text-xs text-base-content/70">
              {platform_label(entry.game)}
            </p>
          </button>
          <button
            id={"edit-entry-#{entry.id}"}
            class="sr-only"
            phx-click="edit_entry"
            phx-value-id={entry.id}
          >Editar</button>
          <button
            id={"remove-entry-#{entry.id}"}
            class="sr-only"
            phx-click="remove_entry"
            phx-value-id={entry.id}
          >Remover</button>
        <% end %>
      <% end %>
      <div :if={@entries == []} class="col-span-full">
        <.empty_state title="Biblioteca vazia" />
      </div>
    </div>

    <section id="ownerships-list" class="border-t border-base-content/10 pt-6">
      <h2 class="text-sm font-bold uppercase tracking-wide text-base-content/70">Posse</h2>
      <div class="mt-3 divide-y divide-base-content/10">
        <%= for ownership <- @ownerships do %>
          <div
            id={"ownership-#{ownership.id}"}
            class="flex items-center justify-between py-3 text-sm"
          >
            <span class="font-semibold">{ownership.release.game.title}</span><span class="text-base-content/70">{enum_label(
              ownership.release.platform
            )}</span>
            <button
              id={"remove-ownership-#{ownership.id}"}
              class="sr-only"
              phx-click="remove_ownership"
              phx-value-id={ownership.id}
            >Remover</button>
          </div>
        <% end %>
      </div>
    </section>

    <div id="add-game" class="border-t border-base-content/10 pt-6">
      <h2 class="text-sm font-bold uppercase tracking-wide text-base-content/70">Adicionar</h2>
      <div class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        <%= for game <- @games do %>
          <div
            id={"add-game-#{game.id}"}
            class="flex items-center justify-between gap-3 rounded-lg bg-base-200 px-3 py-2"
          >
            <span class="truncate text-sm font-semibold">{game.title}</span><button
              class="btn btn-sm btn-primary"
              phx-click="new_entry"
              phx-value-game_id={game.id}
            >Adicionar</button>
          </div>
        <% end %>
      </div>
    </div>

    <section
      :if={@editing}
      id="entry-editor"
      class="rounded-xl border border-base-content/10 bg-base-100 p-5 shadow-lg"
    >
      <div class="mb-5 flex items-center justify-between">
        <h2 class="text-xl font-bold">{@editing.game.title}</h2><button
          class="btn btn-sm btn-ghost"
          phx-click="filter"
        >Fechar</button>
      </div>
      <.form for={@form} id="entry-form" phx-submit="save_entry" class="grid gap-3 sm:grid-cols-2">
        <.input
          field={@form[:purchase_intent]}
          type="select"
          label="Intenção"
          options={[
            {"Nenhuma", :none},
            {"Interessado", :interested},
            {"Quero", :want},
            {"Planejado", :planned},
            {"Pré-venda", :preordered}
          ]}
        />
        <.input
          field={@form[:play_state]}
          type="select"
          label="Estado"
          options={[
            {"Não iniciado", :unplayed},
            {"Jogando", :playing},
            {"Pausado", :paused},
            {"Terminado", :finished},
            {"Abandonado", :abandoned}
          ]}
        />
        <.input
          field={@form[:backlog]}
          type="select"
          label="Backlog"
          options={[{"Fora", :no}, {"Backlog", :backlog}, {"Ativo", :active}]}
        />
        <.input
          field={@form[:priority]}
          type="select"
          label="Prioridade"
          options={[{"Baixa", :low}, {"Normal", :normal}, {"Alta", :high}]}
        />
        <.money_input field={@form[:target_price_cents]} label="Preço alvo (R$)" />
        <button
          id="save-entry-button"
          class="btn btn-primary min-h-11 sm:col-span-2"
          type="submit"
        >Salvar alterações</button>
      </.form>
    </section>
  </div>
</Layouts.app>
