<Layouts.app flash={@flash} current="Biblioteca">
  <div class="space-y-8">
    <.page_header title="Biblioteca">
      <:actions>
        <a href="#add-game" class="dockd-button dockd-button-primary">Adicionar jogo</a>
      </:actions>
    </.page_header>

    <nav id="library-tabs" class="dockd-tabs" aria-label="Seções da biblioteca">
      <%= for {label, key, count} <- [
        {"Jogando", "playing", @counts.playing},
        {"Backlog", "backlog", @counts.backlog},
        {"Quero", "want", @counts.want},
        {"Coleção", "collection", @counts.collection},
        {"Terminados", "finished", @counts.finished}
      ] do %>
        <button
          id={"library-tab-#{if key == "collection", do: "all", else: key}"}
          class="dockd-tab"
          data-active={to_string(@filters["tab"] == key)}
          phx-click="filter"
          phx-value-tab={key}
        >
          {label}<span class="dockd-count">{count}</span>
        </button>
      <% end %>
    </nav>

    <.form
      for={to_form(@filters, as: :filters)}
      id="library-filter-form"
      phx-change="filter"
      class="max-w-md"
    >
      <.input
        field={to_form(@filters, as: :filters)[:search]}
        name="search"
        label="Buscar na biblioteca"
        value={@filters["search"] || ""}
        placeholder="Nome do jogo"
      />
    </.form>

    <div
      id="library-groups"
      class="grid grid-cols-2 gap-x-4 gap-y-9 sm:grid-cols-3 lg:grid-cols-5 xl:grid-cols-6"
    >
      <%= for entry <- @entries do %>
        <article id={"entry-#{entry.id}"} class="group min-w-0">
          <.link navigate={~p"/jogos/#{entry.game.id}"} class="block">
            <div class="relative">
              <.game_cover title={entry.game.title} cover_url={entry.game.cover_url} />
              <span
                :if={MapSet.member?(@owned_game_ids, entry.game_id)}
                class="absolute right-2 top-2 bg-base-100 px-2 py-1 text-[10px] font-bold"
              >{ownership_label(@ownerships_by_game, entry.game_id)}</span>
            </div>
            <span class="dockd-game-title">{entry.game.title}</span>
            <span :if={platform_label(entry.game)} class="dockd-meta mt-1 block">
              {platform_label(entry.game)}
            </span>
          </.link>
          <div class="mt-2 flex items-center justify-between gap-2">
            <span :if={status_label(entry)} class="dockd-meta">{status_label(entry)}</span>
            <span :if={!status_label(entry)} class="dockd-meta">Não iniciado</span>
            <button
              id={"edit-entry-#{entry.id}"}
              type="button"
              class="dockd-meta font-bold underline underline-offset-2"
              phx-click="edit_entry"
              phx-value-id={entry.id}
            >Editar</button>
          </div>
          <.form
            for={to_form(%{"play_state" => entry.play_state})}
            id={"state-form-#{entry.id}"}
            phx-change="quick_state"
            phx-value-id={entry.id}
            class="mt-2"
          >
            <.input
              field={to_form(%{"play_state" => entry.play_state})[:play_state]}
              id={"state-#{entry.id}"}
              name="play_state"
              type="select"
              label="Estado"
              class="w-full select text-xs"
              options={[
                {"Não jogado", :unplayed},
                {"Jogando", :playing},
                {"Pausado", :paused},
                {"Terminado", :finished},
                {"Abandonado", :abandoned}
              ]}
              value={entry.play_state}
            />
          </.form>
          <button
            id={"remove-entry-#{entry.id}"}
            type="button"
            class="dockd-meta mt-1 text-error underline underline-offset-2"
            phx-click="remove_entry"
            phx-value-id={entry.id}
            data-confirm="Remover este jogo da biblioteca?"
          >Remover</button>
        </article>
      <% end %>
      <div :if={@entries == []} class="col-span-full">
        <.empty_state title="Nenhum jogo nesta lista" />
      </div>
    </div>

    <div :if={@orphan_ownerships != []} id="ownerships-list" class="dockd-section">
      <h2 class="dockd-section-title">Posse sem entrada</h2>
      <div class="mt-3 divide-y divide-base-content/10">
        <%= for ownership <- @orphan_ownerships do %>
          <div
            id={"ownership-#{ownership.id}"}
            class="flex items-center justify-between gap-3 py-3 text-sm"
          >
            <span class="font-bold">{ownership.release.game.title}</span>
            <span class="dockd-meta">{enum_label(ownership.ownership_type)}</span>
            <button
              id={"remove-ownership-#{ownership.id}"}
              type="button"
              class="dockd-meta text-error underline underline-offset-2"
              phx-click="remove_ownership"
              phx-value-id={ownership.id}
            >Remover</button>
          </div>
        <% end %>
      </div>
    </div>

    <div id="add-game" class="dockd-section">
      <h2 class="dockd-section-title">Adicionar da biblioteca</h2>
      <div class="mt-4 grid gap-x-4 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">
        <%= for game <- @games do %>
          <div
            id={"add-game-#{game.id}"}
            class="flex items-center justify-between gap-3 border-b border-base-content/10 py-2"
          >
            <span class="truncate text-sm font-bold">{game.title}</span>
            <%= if MapSet.member?(MapSet.new(@all_entries, & &1.game_id), game.id) do %>
              <span class="dockd-meta">Adicionado</span>
            <% else %>
              <button
                class="dockd-meta font-bold text-primary"
                phx-click="new_entry"
                phx-value-game_id={game.id}
              >Adicionar</button>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <section
      :if={@editing}
      id="entry-editor"
      tabindex="-1"
      phx-mounted={JS.focus(to: "#entry-editor")}
      class="dockd-panel outline-none"
    >
      <div class="flex items-center justify-between gap-4">
        <h2 class="dockd-section-title">Editar {@editing.game.title}</h2>
        <button
          type="button"
          class="dockd-meta font-bold underline underline-offset-2"
          phx-click="close_editor"
        >Fechar</button>
      </div>
      <.form
        for={@form}
        id="entry-form"
        phx-submit="save_entry"
        class="mt-5 grid gap-3 sm:grid-cols-2"
      >
        <.input
          field={@form[:purchase_intent]}
          type="select"
          label="Intenção"
          options={[
            {"Nenhuma", :none},
            {"Interessado", :interested},
            {"Quero", :want},
            {"Planejado", :planned},
            {"Pré-venda", :preordered}
          ]}
        />
        <.input
          field={@form[:play_state]}
          type="select"
          label="Estado"
          options={[
            {"Não iniciado", :unplayed},
            {"Jogando", :playing},
            {"Pausado", :paused},
            {"Terminado", :finished},
            {"Abandonado", :abandoned}
          ]}
        />
        <.input
          field={@form[:backlog]}
          type="select"
          label="Backlog"
          options={[{"Fora", :no}, {"Backlog", :backlog}, {"Ativo", :active}]}
        />
        <.input
          field={@form[:priority]}
          type="select"
          label="Prioridade"
          options={[{"Baixa", :low}, {"Normal", :normal}, {"Alta", :high}]}
        />
        <.money_input field={@form[:target_price_cents]} label="Preço alvo (R$)" />
        <button
          id="save-entry-button"
          class="dockd-button dockd-button-primary sm:col-span-2"
          type="submit"
        >Salvar alterações</button>
      </.form>
    </section>
  </div>
</Layouts.app>
