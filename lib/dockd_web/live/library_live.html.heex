<Layouts.app flash={@flash} current="Lista">
  <div id="list">
    <.page_header title="Lista">
      <:actions>
        <.link navigate="/catalogo" class="dockd-button dockd-button-primary">Descobrir</.link>
      </:actions>
    </.page_header>

    <div class="list-toolbar">
      <.form for={@search_form} id="list-search-form" phx-change="filter">
        <.input
          field={@search_form[:search]}
          id="list-search"
          label="Buscar"
          placeholder="Título"
          value={@search}
          class="search-field"
          phx-debounce="250"
        />
      </.form>
      <span id="list-count" class="text-xs text-base-content/60">{length(@entries)}</span>
    </div>

    <div id="list-games" data-testid="list-items" class="library-grid">
      <%= for entry <- @entries do %>
        <article id={"list-entry-#{entry.id}"} class="library-item group">
          <.link
            navigate={"/jogos/#{entry.game.id}?from=list"}
            id={"list-game-#{entry.game.id}"}
            class="block"
          >
            <.game_cover title={entry.game.title} cover_url={entry.game.cover_url} />
            <h2>{entry.game.title}</h2>
            <p>{platform_label(entry.game)}</p>
          </.link>
          <div class="list-relation">
            <span>Na lista</span>
            <button
              id={"remove-list-#{entry.id}"}
              phx-click="remove_from_list"
              phx-value-id={entry.id}
            >Tirar</button>
          </div>
        </article>
      <% end %>
      <div :if={@entries == []} id="list-empty" class="library-empty">
        <strong>Lista vazia</strong>
        <.link navigate="/catalogo" class="link-action">Descobrir jogos</.link>
      </div>
    </div>
  </div>
</Layouts.app>
