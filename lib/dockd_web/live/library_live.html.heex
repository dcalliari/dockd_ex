<Layouts.app flash={@flash} current="Biblioteca">
  <div class="space-y-7">
    <.page_header title="Biblioteca">
      <:actions>
        <.link navigate="/catalogo" class="btn btn-primary min-h-10">Descobrir</.link>
      </:actions>
    </.page_header>

    <nav
      id="library-tabs"
      class="flex gap-1 overflow-x-auto border-b border-base-content/10"
      aria-label="Seções da biblioteca"
    >
      <%= for {label, key, count} <- [{"Jogando", "playing", @tab_counts.playing}, {"Backlog", "backlog", @tab_counts.backlog}, {"Quero", "want", @tab_counts.want}, {"Coleção", "all", @tab_counts.all}, {"Terminados", "finished", @tab_counts.finished}] do %>
        <button
          id={"library-tab-#{key}"}
          class={[
            "shrink-0 whitespace-nowrap border-b-2 px-3 py-3 text-sm font-semibold transition-colors",
            @filters["tab"] == key && "border-primary text-primary",
            @filters["tab"] != key &&
              "border-transparent text-base-content/65 hover:text-base-content"
          ]}
          phx-click="filter"
          phx-value-tab={key}
        >
          {label}<span class="ml-1 text-xs">{count}</span>
        </button>
      <% end %>
    </nav>

    <.form
      for={to_form(@filters, as: :filters)}
      id="library-filter-form"
      phx-change="filter"
      class="max-w-sm"
    >
      <.input
        field={to_form(@filters, as: :filters)[:search]}
        name="search"
        label="Buscar"
        value={@filters["search"] || ""}
      />
    </.form>

    <div
      id="library-groups"
      class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5"
    >
      <%= for entry <- @entries do %>
        <article id={"entry-#{entry.id}"} class="group relative min-w-0">
          <button
            id={"state-cover-#{entry.id}"}
            class="relative block w-full text-left"
            phx-click="toggle_state_menu"
            phx-value-id={entry.id}
            aria-label={"Alterar estado de #{entry.game.title}"}
          >
            <.game_cover
              title={entry.game.title}
              cover_url={entry.game.cover_url}
              class="transition duration-200 group-hover:-translate-y-1 group-hover:shadow-xl"
            />
            <span
              :if={status_label(entry)}
              class="absolute bottom-2 left-2 rounded-md bg-base-100/90 px-2 py-1 text-[11px] font-semibold shadow-sm"
            >{status_label(entry)}</span>
          </button>
          <div
            :if={@state_menu_id == to_string(entry.id)}
            id={"state-menu-#{entry.id}"}
            class="absolute inset-x-1 top-2 z-10 grid gap-1 rounded-xl border border-base-content/10 bg-base-100/95 p-2 shadow-xl backdrop-blur"
          >
            <span class="px-2 pb-1 text-[10px] font-bold uppercase tracking-widest text-base-content/50">Estado</span>
            <button
              :for={
                {label, state} <- [
                  {"Jogando", "playing"},
                  {"Terminado", "finished"},
                  {"Abandonado", "abandoned"},
                  {"Backlog", "backlog"}
                ]
              }
              class="rounded-lg px-2 py-2 text-left text-xs font-semibold hover:bg-base-200"
              phx-click="set_state"
              phx-value-id={entry.id}
              phx-value-state={state}
            >{label}</button>
          </div>
          <button
            id={"edit-entry-#{entry.id}"}
            class="mt-3 block max-w-full truncate text-left font-bold hover:text-primary"
            phx-click="edit_entry"
            phx-value-id={entry.id}
          >{entry.game.title}</button>
          <p class="mt-1 text-xs text-base-content/70">
            {ownership_label(entry.game_id, @ownerships)} · {platform_label(entry.game)}
          </p>
        </article>
      <% end %>
      <div
        :if={@entries == []}
        class="col-span-full py-10 text-center text-sm text-base-content/60"
      >
        Nenhum jogo
      </div>
    </div>

    <section
      :if={@editing}
      id="entry-editor"
      class="max-w-3xl border-t border-base-content/10 pt-6"
    >
      <div class="mb-5 flex items-center justify-between gap-3">
        <h2 class="text-xl font-bold">{@editing.game.title}</h2>
        <button class="btn btn-sm btn-ghost" phx-click="filter">Fechar</button>
      </div>
      <.form for={@form} id="entry-form" phx-submit="save_entry" class="grid gap-3 sm:grid-cols-2">
        <.input
          field={@form[:purchase_intent]}
          type="select"
          label="Intenção"
          options={[
            {"Nenhuma", :none},
            {"Interessado", :interested},
            {"Quero", :want},
            {"Planejado", :planned},
            {"Pré-venda", :preordered}
          ]}
        />
        <.input
          field={@form[:play_state]}
          type="select"
          label="Estado"
          options={[
            {"Não iniciado", :unplayed},
            {"Jogando", :playing},
            {"Pausado", :paused},
            {"Terminado", :finished},
            {"Abandonado", :abandoned}
          ]}
        />
        <.input
          field={@form[:backlog]}
          type="select"
          label="Backlog"
          options={[{"Fora", :no}, {"Backlog", :backlog}, {"Ativo", :active}]}
        />
        <.input
          field={@form[:priority]}
          type="select"
          label="Prioridade"
          options={[{"Baixa", :low}, {"Normal", :normal}, {"Alta", :high}]}
        />
        <.money_input field={@form[:target_price_cents]} label="Preço alvo (R$)" />
        <button
          id="save-entry-button"
          class="btn btn-primary min-h-11 sm:col-span-2"
          type="submit"
        >
          Salvar
        </button>
      </.form>
      <button
        id={"remove-entry-#{@editing.id}"}
        class="mt-5 text-sm font-semibold text-error"
        phx-click="remove_entry"
        phx-value-id={@editing.id}
        data-confirm="Remover este jogo?"
      >Remover</button>
    </section>

    <section id="ownerships-list" class="hidden" aria-hidden="true">
      <%= for ownership <- @ownerships do %>
        <div id={"ownership-#{ownership.id}"}>
          <button
            id={"remove-ownership-#{ownership.id}"}
            phx-click="remove_ownership"
            phx-value-id={ownership.id}
          >Remover</button>
        </div>
      <% end %>
    </section>

    <section id="add-game" class="hidden" aria-hidden="true">
      <%= for game <- @games do %>
        <div id={"add-game-#{game.id}"}>
          <button phx-click="new_entry" phx-value-game_id={game.id}>Adicionar</button>
        </div>
      <% end %>
    </section>
  </div>
</Layouts.app>
