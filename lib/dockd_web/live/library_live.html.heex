<Layouts.app flash={@flash} current="Biblioteca">
  <div class="space-y-8">
    <.page_header
      eyebrow="Sua coleção"
      title="Biblioteca"
      description="Dê contexto ao que você quer jogar e ao que merece esperar antes da próxima compra."
    >
      <:actions>
        <a href="#add-game" class="btn btn-primary min-h-11">Adicionar jogo</a>
      </:actions>
    </.page_header>

    <.section_card title="Filtrar biblioteca" class="bg-base-200">
      <.form
        for={to_form(@filters, as: :filters)}
        id="library-filter-form"
        phx-change="filter"
        class="grid gap-3 sm:grid-cols-3"
      >
        <.input
          field={to_form(@filters, as: :filters)[:search]}
          name="search"
          label="Buscar por título"
          value={@filters["search"] || ""}
        />
        <.input
          field={to_form(@filters, as: :filters)[:backlog]}
          name="backlog"
          type="select"
          label="Backlog"
          options={[{"Todos", ""}, {"Backlog", "backlog"}, {"Ativo", "active"}, {"Fora", "no"}]}
          value={@filters["backlog"] || ""}
        />
        <.input
          field={to_form(@filters, as: :filters)[:play_state]}
          name="play_state"
          type="select"
          label="Estado"
          options={[
            {"Todos", ""},
            {"Jogando", "playing"},
            {"Não iniciado", "unplayed"},
            {"Terminado", "finished"},
            {"Abandonado", "abandoned"}
          ]}
          value={@filters["play_state"] || ""}
        />
      </.form>
    </.section_card>

    <div id="library-groups" class="grid gap-6 xl:grid-cols-2">
      <%= for {group, entries} <- @groups do %>
        <.section_card title={group}>
          <div
            id={"library-group-#{group |> String.downcase() |> String.replace(" ", "-")}"}
            class="space-y-3"
          >
            <%= for entry <- entries do %>
              <article
                id={"entry-#{entry.id}"}
                class="rounded-xl border border-base-content/10 p-4 transition hover:border-primary/50"
              >
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div class="min-w-0">
                    <h3 class="truncate text-lg font-bold">{entry.game.title}</h3>
                    <div class="mt-2 flex flex-wrap gap-2">
                      <.status_chip label={enum_label(entry.purchase_intent)} tone="primary" />
                      <.status_chip label={enum_label(entry.play_state)} tone="neutral" />
                      <.status_chip label={enum_label(entry.priority)} tone="secondary" />
                      <%= for release <- entry.game.releases do %>
                        <.platform_badge platform={release.platform} />
                      <% end %>
                    </div>
                  </div>
                  <div class="text-right text-sm text-base-content/70">
                    <p class="font-semibold">
                      {target_price(entry.target_price_cents, entry.currency)}
                    </p>
                    <p :if={entry.owned_elsewhere} class="mt-1 text-xs">
                      Já tenho em outra plataforma
                    </p>
                  </div>
                </div>
                <div class="mt-4 flex flex-wrap gap-2">
                  <button
                    id={"edit-entry-#{entry.id}"}
                    class="btn btn-sm btn-outline min-h-10"
                    phx-click="edit_entry"
                    phx-value-id={entry.id}
                  >Editar</button>
                  <button
                    id={"remove-entry-#{entry.id}"}
                    class="btn btn-sm btn-ghost min-h-10 text-error"
                    phx-click="remove_entry"
                    phx-value-id={entry.id}
                    data-confirm="Remover esta entrada?"
                  >Remover</button>
                </div>
              </article>
            <% end %>
            <.empty_state
              :if={entries == []}
              title="Nada por aqui"
              description="Adicione um jogo para começar a organizar sua decisão."
            />
          </div>
        </.section_card>
      <% end %>
    </div>

    <.section_card title="Posse registrada" class="bg-base-200">
      <div id="ownerships-list" class="space-y-3">
        <%= for ownership <- @ownerships do %>
          <article
            id={"ownership-#{ownership.id}"}
            class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-base-content/10 bg-base-100 p-4"
          >
            <div>
              <p class="font-bold">{ownership.release.game.title}</p>
              <p class="text-sm text-base-content/60">
                {enum_label(ownership.ownership_type)} · {enum_label(ownership.release.platform)}
              </p>
            </div>
            <button
              id={"remove-ownership-#{ownership.id}"}
              class="btn btn-sm btn-ghost text-error"
              phx-click="remove_ownership"
              phx-value-id={ownership.id}
            >Remover</button>
          </article>
        <% end %>
        <.empty_state
          :if={@ownerships == []}
          title="Nenhuma posse registrada"
          description="Compras e acessos aparecem aqui para separar posse de intenção."
        />
      </div>
    </.section_card>

    <div id="add-game">
      <.section_card title="Adicionar um jogo" class="bg-base-200">
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          <%= for game <- @games do %>
            <div
              id={"add-game-#{game.id}"}
              class="flex min-w-0 items-center justify-between gap-3 rounded-xl border border-base-content/10 bg-base-100 p-3"
            >
              <span class="truncate font-semibold">{game.title}</span>
              <button
                class="btn btn-sm btn-primary min-h-10 shrink-0"
                phx-click="new_entry"
                phx-value-game_id={game.id}
              >Adicionar</button>
            </div>
          <% end %>
        </div>
      </.section_card>
    </div>

    <.section_card :if={@editing} title={"Editando #{@editing.game.title}"}>
      <.form for={@form} id="entry-form" phx-submit="save_entry" class="grid gap-3 sm:grid-cols-2">
        <.input
          field={@form[:purchase_intent]}
          type="select"
          label="Intenção de compra"
          options={[
            {"Nenhuma", :none},
            {"Interessado", :interested},
            {"Quero", :want},
            {"Planejado", :planned},
            {"Pré-venda", :preordered}
          ]}
        />
        <.input
          field={@form[:play_state]}
          type="select"
          label="Estado de jogo"
          options={[
            {"Não iniciado", :unplayed},
            {"Jogando", :playing},
            {"Pausado", :paused},
            {"Terminado", :finished},
            {"Abandonado", :abandoned}
          ]}
        />
        <.input
          field={@form[:backlog]}
          type="select"
          label="Backlog"
          options={[{"Fora", :no}, {"Backlog", :backlog}, {"Ativo", :active}]}
        />
        <.input
          field={@form[:priority]}
          type="select"
          label="Prioridade"
          options={[{"Baixa", :low}, {"Normal", :normal}, {"Alta", :high}]}
        />
        <.input
          field={@form[:media_preference]}
          type="select"
          label="Preferência de mídia"
          options={[
            {"Qualquer", :either},
            {"Físico", :physical},
            {"Digital", :digital},
            {"Prefiro físico", :physical_preferred},
            {"Prefiro digital", :digital_preferred}
          ]}
        />
        <.money_input field={@form[:target_price_cents]} label="Preço alvo (R$)" />
        <.input field={@form[:currency]} label="Moeda" />
        <.input
          field={@form[:owned_elsewhere]}
          type="checkbox"
          label="Já tenho em outra plataforma"
        />
        <.input field={@form[:owned_elsewhere_note]} label="Onde / observação" />
        <.input field={@form[:notes]} type="textarea" label="Notas" class="sm:col-span-2" />
        <button
          id="save-entry-button"
          class="btn btn-primary min-h-11 sm:col-span-2"
          type="submit"
        >Salvar alterações</button>
      </.form>
    </.section_card>
  </div>
</Layouts.app>
