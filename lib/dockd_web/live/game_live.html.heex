<Layouts.app flash={@flash} current={@return_label}>
  <div id="game">
    <div class="screen-header">
      <.link
        id="game-back"
        navigate={@return_to}
        class="link-action inline-flex items-center gap-2"
      >
        <.icon name="hero-arrow-left" class="size-4" /> {@return_label}
      </.link>
    </div>

    <section id="game-hero" class="game-hero">
      <.game_cover title={@game.title} cover_url={@game.cover_url} class="game-cover" />
      <div class="min-w-0">
        <h1>{@game.title}</h1>
        <p id="game-platform" class="game-platform">{platform_label(@game)}</p>
        <div id="game-relation" class="game-action-row">
          <%= if relation?(@entry) do %>
            <span class="relation active">Na lista</span>
            <button
              id="remove-from-list"
              class="dockd-button dockd-button-secondary"
              phx-click="remove_from_list"
            >Tirar da lista</button>
          <% else %>
            <button
              id="add-to-list"
              class="dockd-button dockd-button-primary"
              phx-click="add_to_list"
            >Quero jogar</button>
          <% end %>
        </div>
      </div>
    </section>

    <section id="game-releases" class="game-releases">
      <%= for release <- @game.releases do %>
        <div id={"game-release-#{release.id}"} class="game-release">
          <span>{enum_label(release.platform)}</span>
          <time :if={release.release_date} datetime={Date.to_iso8601(release.release_date)}>
            {release_date_label(release)}
          </time>
          <span :if={is_nil(release.release_date)}>{release_date_label(release)}</span>
        </div>
      <% end %>
    </section>
  </div>
</Layouts.app>
