<Layouts.app flash={@flash} current="Catálogo">
  <div class="mx-auto max-w-6xl space-y-10">
    <div class="flex items-center justify-between gap-4">
      <.link navigate={~p"/catalogo"} class="dockd-meta font-bold underline underline-offset-2">← Catálogo</.link>
      <.link navigate={~p"/biblioteca"} class="dockd-meta font-bold underline underline-offset-2">Biblioteca</.link>
    </div>

    <section class="grid items-start gap-6 sm:grid-cols-[12rem_1fr] lg:grid-cols-[15rem_1fr]">
      <.game_cover title={@game.title} cover_url={@game.cover_url} />
      <div class="min-w-0">
        <h1 class="dockd-page-title max-w-3xl">{@game.title}</h1>
        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm">
          <span>{enum_label(@game.availability)}</span>
          <span :if={@game.pace} class="dockd-meta">{enum_label(@game.pace)}</span>
          <span :if={@game.play_mode} class="dockd-meta">{enum_label(@game.play_mode)}</span>
          <span :if={@game.estimated_duration_minutes} class="dockd-meta">{@game.estimated_duration_minutes} min</span>
        </div>
        <p :if={@ownerships != []} class="mt-6 text-sm font-bold text-primary">
          Você possui este jogo
        </p>
      </div>
    </section>

    <section id="game-history" class="dockd-section">
      <h2 class="dockd-section-title">Meu histórico</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <%= for ownership <- @ownerships do %>
          <div
            id={"ownership-#{ownership.id}"}
            class="flex justify-between gap-4 border-b border-base-content/10 py-2 text-sm"
          >
            <span>Posse {enum_label(ownership.ownership_type)}</span>
            <span class="dockd-meta">{enum_label(ownership.release.platform)}</span>
          </div>
        <% end %>
        <%= for purchase <- @purchases do %>
          <div
            id={"purchase-#{purchase.id}"}
            class="flex justify-between gap-4 border-b border-base-content/10 py-2 text-sm"
          >
            <span>Compra em {date_pt_br(DateTime.to_date(purchase.purchased_at))}</span>
            <span class="dockd-value">{money(purchase.price_cents, purchase.currency)}</span>
          </div>
        <% end %>
      </div>
      <.empty_state
        :if={@ownerships == [] and @purchases == []}
        title="Nenhum registro pessoal ainda"
      />
    </section>

    <.section_card title="Minha entrada">
      <div :if={@entry} class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
        <.status_mark
          :if={@entry.purchase_intent not in [nil, :none]}
          label={enum_label(@entry.purchase_intent)}
          tone="secondary"
        />
        <.status_mark
          :if={@entry.play_state not in [nil, :unplayed]}
          label={enum_label(@entry.play_state)}
        />
        <span :if={@entry.target_price_cents} class="dockd-value font-bold">Alvo: {money(
          @entry.target_price_cents,
          @entry.currency
        )}</span>
      </div>
      <p :if={!@entry} class="dockd-note">Este jogo ainda não está na sua biblioteca.</p>
      <details id="entry-editor" class="mt-4">
        <summary class="dockd-button dockd-button-quiet inline-flex cursor-pointer">
          {if @entry, do: "Editar entrada", else: "Adicionar à biblioteca"}
        </summary>
        <.form
          for={@entry_form}
          id="entry-form"
          phx-submit="save_entry"
          class="mt-5 grid gap-4 sm:grid-cols-3"
        >
          <.input
            field={@entry_form[:purchase_intent]}
            type="select"
            label="Intenção"
            options={[
              {"Nenhuma", :none},
              {"Interessado", :interested},
              {"Quero", :want},
              {"Planejado", :planned},
              {"Pré-venda", :preordered}
            ]}
          />
          <.input
            field={@entry_form[:play_state]}
            type="select"
            label="Estado"
            options={[
              {"Não jogado", :unplayed},
              {"Jogando", :playing},
              {"Pausado", :paused},
              {"Terminado", :finished},
              {"Abandonado", :abandoned}
            ]}
          />
          <.money_input field={@entry_form[:target_price_cents]} label="Preço alvo (R$)" />
          <button
            id="save-entry-button"
            class="dockd-button dockd-button-primary sm:col-span-3"
            type="submit"
          >Salvar entrada</button>
        </.form>
      </details>
    </.section_card>

    <section id="releases" class="grid gap-8 lg:grid-cols-2">
      <%= for release <- @game.releases do %>
        <% veto = Library.get_veto_for_release(@user, release.id) %>
        <% observations = Purchasing.list_price_observations(@user, release.id) %>
        <% purchases = Map.get(@purchases_by_release, release.id, []) %>
        <article id={"release-#{release.id}"} class={["dockd-release", veto && "border-error/50"]}>
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h2 class="text-lg font-black">{release_title(release)}</h2>
            <span class="dockd-meta">{release_status(release)}</span>
          </div>
          <div class="mt-2 flex flex-wrap gap-2">
            <.platform_badge platform={release.platform} />
            <.media_badge :if={release.physical_available} media={:physical} />
            <.media_badge :if={release.digital_available} media={:digital} />
            <.status_mark :if={veto} label="vetada" tone="error" />
            <span
              :if={ownership_label(@ownerships_by_release, release.id) != ""}
              class="dockd-tag dockd-tag-primary"
            >{ownership_label(@ownerships_by_release, release.id)}</span>
          </div>
          <p :if={veto} class="mt-3 text-sm text-error">
            {veto.reason || "Sem motivo informado"}
          </p>

          <div class="mt-6">
            <h3 class="dockd-section-title">Preços observados</h3>
            <.empty_state :if={observations == []} title="Nenhuma observação" />
            <div :if={observations != []} class="mt-3 space-y-3">
              <%= for observation <- observations do %>
                <.dated_value
                  value={observation.price_cents}
                  currency={observation.currency}
                  observed_at={DateTime.to_date(observation.observed_at)}
                  stale={Purchasing.stale?(observation, DateTime.utc_now())}
                />
              <% end %>
            </div>
          </div>

          <div :if={purchases != []} class="mt-6">
            <h3 class="dockd-section-title">Compras</h3>
            <div class="mt-3 space-y-2 text-sm">
              <%= for purchase <- purchases do %>
                <div class="flex justify-between gap-3">
                  <span>{date_pt_br(DateTime.to_date(purchase.purchased_at))} · {enum_label(
                    purchase.format
                  )}</span>
                  <span class="dockd-value">{money(purchase.price_cents, purchase.currency)}</span>
                </div>
              <% end %>
            </div>
          </div>

          <div class="mt-6 flex flex-wrap gap-2">
            <details>
              <summary class="dockd-button dockd-button-quiet cursor-pointer">
                Registrar preço
              </summary>
              <.form
                for={Map.get(@observation_forms, release.id, to_form(%{}, as: :observation))}
                id={"observation-form-#{release.id}"}
                phx-submit="save_observation"
                class="mt-4 grid gap-3 sm:grid-cols-2"
              >
                <input type="hidden" name="release_id" value={release.id} />
                <input type="hidden" name="observation[currency]" value="BRL" />
                <.input
                  field={
                    Map.get(@observation_forms, release.id, to_form(%{}, as: :observation))[
                      :format
                    ]
                  }
                  type="select"
                  id={"observation-format-#{release.id}"}
                  label="Formato"
                  options={[{"Físico", :physical}, {"Digital", :digital}]}
                />
                <.input
                  field={
                    Map.get(@observation_forms, release.id, to_form(%{}, as: :observation))[
                      :price_cents
                    ]
                  }
                  type="text"
                  inputmode="decimal"
                  id={"observation-price-#{release.id}"}
                  label="Preço (R$)"
                  placeholder="199,90"
                />
                <.input
                  field={
                    Map.get(@observation_forms, release.id, to_form(%{}, as: :observation))[
                      :source
                    ]
                  }
                  id={"observation-source-#{release.id}"
                  }
                  label="Fonte"
                  placeholder="eShop ou loja"
                />
                <.input
                  field={
                    Map.get(@observation_forms, release.id, to_form(%{}, as: :observation))[
                      :observed_at
                    ]
                  }
                  type="datetime-local"
                  id={"observation-at-#{release.id}"}
                  label="Observado em"
                />
                <button class="dockd-button dockd-button-primary sm:col-span-2" type="submit">Salvar observação</button>
              </.form>
            </details>
            <details>
              <summary class="dockd-button dockd-button-primary cursor-pointer">
                Registrar compra
              </summary>
              <.form
                for={Map.get(@purchase_forms, release.id, to_form(%{}, as: :purchase))}
                id={"purchase-form-#{release.id}"}
                phx-submit="save_purchase"
                class="mt-4 grid gap-3 sm:grid-cols-2"
              >
                <input type="hidden" name="release_id" value={release.id} />
                <.input
                  field={
                    Map.get(@purchase_forms, release.id, to_form(%{}, as: :purchase))[:format]
                  }
                  type="select"
                  id={"purchase-format-#{release.id}"}
                  label="Compra em"
                  options={[{"Físico", :physical}, {"Digital", :digital}]}
                />
                <.input
                  field={
                    Map.get(@purchase_forms, release.id, to_form(%{}, as: :purchase))[
                      :price_cents
                    ]
                  }
                  type="text"
                  inputmode="decimal"
                  id={"purchase-price-#{release.id}"}
                  label="Preço (R$)"
                  placeholder="199,90"
                />
                <.input
                  field={
                    Map.get(@purchase_forms, release.id, to_form(%{}, as: :purchase))[:retailer]
                  }
                  id={"purchase-retailer-#{release.id}"}
                  label="Varejista"
                />
                <.input
                  field={
                    Map.get(@purchase_forms, release.id, to_form(%{}, as: :purchase))[
                      :purchased_at
                    ]
                  }
                  type="datetime-local"
                  id={"purchase-at-#{release.id}"}
                  label="Comprado em"
                />
                <button class="dockd-button dockd-button-primary sm:col-span-2" type="submit">Salvar compra</button>
              </.form>
            </details>
            <%= if veto do %>
              <button
                class="dockd-button dockd-button-danger"
                phx-click="undo_veto"
                phx-value-id={veto.id}
              >Desfazer veto</button>
            <% else %>
              <details>
                <summary class="dockd-button dockd-button-danger cursor-pointer">
                  Vetar versão
                </summary>
                <.form
                  for={Map.get(@veto_forms, release.id, to_form(%{}, as: :veto))}
                  id={"veto-form-#{release.id}"}
                  phx-submit="save_veto"
                  class="mt-4 flex gap-2"
                >
                  <input type="hidden" name="release_id" value={release.id} />
                  <.input
                    field={Map.get(@veto_forms, release.id, to_form(%{}, as: :veto))[:reason]}
                    id={"veto-reason-#{release.id}"}
                    label="Motivo"
                  />
                  <button class="dockd-button dockd-button-quiet self-end" type="submit">Confirmar veto</button>
                </.form>
              </details>
            <% end %>
          </div>
        </article>
      <% end %>
      <div :if={@game.releases == []} class="col-span-full">
        <.empty_state title="Nenhuma versão cadastrada" />
      </div>
    </section>
  </div>
</Layouts.app>
