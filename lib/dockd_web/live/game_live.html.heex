<Layouts.app flash={@flash} current={@return_label}>
  <div class="space-y-8">
    <.link
      id="game-back"
      navigate={@return_to}
      class="inline-flex items-center gap-2 text-sm font-semibold text-primary"
    >
      <.icon name="hero-arrow-left" class="size-4" /> {@return_label}
    </.link>

    <section
      id="game-hero"
      class="grid grid-cols-[6rem_1fr] items-start gap-5 sm:grid-cols-[11rem_1fr] sm:gap-7"
    >
      <.game_cover title={@game.title} cover_url={@game.cover_url} class="w-full" />
      <div class="min-w-0">
        <h1 class="display text-3xl font-black leading-none tracking-tight sm:text-5xl">
          {@game.title}
        </h1>
        <div class="mt-5 flex flex-wrap gap-2" aria-label="Relação com o jogo">
          <span :if={@owned?} class="game-relation game-relation-active">Tem</span>
          <span
            :if={@entry && @entry.purchase_intent in [:want, :planned, :preordered]}
            class="game-relation game-relation-active"
          >Quer</span>
          <span
            :if={@entry && @entry.play_state == :playing}
            class="game-relation game-relation-active"
          >Jogando</span>
          <span :if={!@owned? && is_nil(@entry)} class="game-relation">Catálogo</span>
        </div>
        <div class="mt-6 flex flex-wrap gap-2">
          <details :if={@entry} id="entry-editor">
            <summary class="btn btn-primary btn-sm cursor-pointer">Estado</summary>
            <.form
              for={@entry_form}
              id="entry-form"
              phx-submit="save_entry"
              class="mt-4 grid gap-3 rounded-xl border border-base-content/10 bg-base-100 p-4 sm:grid-cols-2"
            >
              <.input
                field={@entry_form[:purchase_intent]}
                type="select"
                label="Intenção"
                options={[{"Quero", :want}, {"Interessado", :interested}, {"Nenhuma", :none}]}
              />
              <.input
                field={@entry_form[:play_state]}
                type="select"
                label="Estado"
                options={[
                  {"Não jogado", :unplayed},
                  {"Jogando", :playing},
                  {"Terminado", :finished},
                  {"Abandonado", :abandoned}
                ]}
              />
              <.money_input field={@entry_form[:target_price_cents]} label="Preço alvo (R$)" />
              <button id="save-entry-button" class="btn btn-primary sm:col-span-2" type="submit">Salvar</button>
            </.form>
          </details>
          <details :if={is_nil(@entry)}>
            <summary class="btn btn-primary btn-sm cursor-pointer">Adicionar</summary>
            <.form
              for={@entry_form}
              id="entry-form"
              phx-submit="save_entry"
              class="mt-4 grid gap-3 rounded-xl border border-base-content/10 bg-base-100 p-4 sm:grid-cols-2"
            >
              <.input
                field={@entry_form[:purchase_intent]}
                type="select"
                label="Intenção"
                options={[{"Quero", :want}, {"Interessado", :interested}, {"Nenhuma", :none}]}
              />
              <.input
                field={@entry_form[:play_state]}
                type="select"
                label="Estado"
                options={[
                  {"Não jogado", :unplayed},
                  {"Jogando", :playing},
                  {"Terminado", :finished},
                  {"Abandonado", :abandoned}
                ]}
              />
              <.money_input field={@entry_form[:target_price_cents]} label="Preço alvo (R$)" />
              <button id="save-entry-button" class="btn btn-primary sm:col-span-2" type="submit">Salvar</button>
            </.form>
          </details>
        </div>
      </div>
    </section>

    <section id="releases" class="space-y-4">
      <%= for data <- @release_data do %>
        <% release = data.release %>
        <article
          id={"release-#{release.id}"}
          class={["game-release", data.veto && "game-release-vetoed"]}
        >
          <header class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <h2 class="font-bold">{release.edition || "Edição padrão"}</h2>
              <p class="mt-1 text-xs text-base-content/60">
                {enum_label(release.platform)} · {if(release.release_date,
                  do: date_pt_br(release.release_date),
                  else: "Sem data"
                )}
              </p>
            </div>
            <span class={[
              "game-verdict",
              data.verdict == "Abaixo do alvo" && "text-success",
              data.verdict in ["Esperar", "Desatualizado"] && "text-warning",
              data.verdict == "Vetada" && "text-error"
            ]}>{data.verdict}</span>
          </header>
          <div class="mt-5 grid gap-3 border-y border-base-content/10 py-4 text-sm sm:grid-cols-3">
            <div>
              <span class="block text-xs text-base-content/55">Disponibilidade</span>
              <strong class="mt-1 block">{if(release.digital_available, do: "Digital", else: "")}{if(
                release.digital_available and release.physical_available,
                do: " · ",
                else: ""
              )}{if(release.physical_available, do: "Físico", else: "")}</strong>
            </div>
            <div>
              <span class="block text-xs text-base-content/55">Observado</span>
              <%= if data.observation do %>
                <strong class="mt-1 block">{money(
                  data.observation.price_cents,
                  data.observation.currency
                )}</strong>
                <span class="block text-xs text-base-content/55">{date_pt_br(
                  DateTime.to_date(data.observation.observed_at)
                )}</span>
              <% else %>
                <strong class="mt-1 block">Sem preço</strong>
              <% end %>
            </div>
            <div>
              <span class="block text-xs text-base-content/55">Alvo</span>
              <strong class="mt-1 block">{if(@entry && @entry.target_price_cents,
                do: money(@entry.target_price_cents, @entry.currency),
                else: "Sem alvo"
              )}</strong>
            </div>
          </div>
          <div :if={data.observations != []} class="space-y-3">
            <%= for observation <- data.observations do %>
              <.dated_value
                value={observation.price_cents}
                currency={observation.currency}
                observed_at={DateTime.to_date(observation.observed_at)}
                stale={Purchasing.stale?(observation, DateTime.utc_now())}
              />
            <% end %>
          </div>
          <div :if={data.veto} class="mt-4 text-sm text-error">
            Vetada{if data.veto.reason, do: " · #{data.veto.reason}", else: ""}
          </div>
          <div class="mt-5 flex flex-wrap gap-2">
            <details>
              <summary class="btn btn-outline btn-primary btn-sm cursor-pointer">
                Registrar preço
              </summary>
              <.form
                for={Map.get(@observation_forms, release.id, to_form(%{}, as: :observation))}
                id={"observation-form-#{release.id}"}
                phx-submit="save_observation"
                class="mt-4 grid gap-3 rounded-xl border border-base-content/10 bg-base-200 p-4 sm:grid-cols-2"
              >
                <input type="hidden" name="release_id" value={release.id} />
                <input type="hidden" name="observation[currency]" value="BRL" />
                <.input
                  field={
                    Map.get(@observation_forms, release.id, to_form(%{}, as: :observation))[
                      :format
                    ]
                  }
                  type="select"
                  id={"observation-format-#{release.id}"}
                  label="Formato"
                  options={[{"Físico", :physical}, {"Digital", :digital}]}
                />
                <.input
                  field={
                    Map.get(@observation_forms, release.id, to_form(%{}, as: :observation))[
                      :price_cents
                    ]
                  }
                  type="text"
                  inputmode="decimal"
                  id={"observation-price-#{release.id}"}
                  label="Preço (R$)"
                  placeholder="199,90"
                />
                <.input
                  field={
                    Map.get(@observation_forms, release.id, to_form(%{}, as: :observation))[
                      :source
                    ]
                  }
                  id={"observation-source-#{release.id}"}
                  label="Fonte"
                  placeholder="eShop ou loja"
                />
                <.input
                  field={
                    Map.get(@observation_forms, release.id, to_form(%{}, as: :observation))[
                      :observed_at
                    ]
                  }
                  type="datetime-local"
                  id={"observation-at-#{release.id}"}
                  label="Observado em"
                />
                <button class="btn btn-secondary sm:col-span-2" type="submit">Salvar</button>
              </.form>
            </details>
            <details>
              <summary class="btn btn-primary btn-sm cursor-pointer">Comprar</summary>
              <.form
                for={Map.get(@purchase_forms, release.id, to_form(%{}, as: :purchase))}
                id={"purchase-form-#{release.id}"}
                phx-submit="save_purchase"
                class="mt-4 grid gap-3 rounded-xl border border-base-content/10 bg-base-200 p-4 sm:grid-cols-2"
              >
                <input type="hidden" name="release_id" value={release.id} />
                <.input
                  field={
                    Map.get(@purchase_forms, release.id, to_form(%{}, as: :purchase))[:format]
                  }
                  type="select"
                  id={"purchase-format-#{release.id}"}
                  label="Compra em"
                  options={[{"Físico", :physical}, {"Digital", :digital}]}
                />
                <.input
                  field={
                    Map.get(@purchase_forms, release.id, to_form(%{}, as: :purchase))[
                      :price_cents
                    ]
                  }
                  type="text"
                  inputmode="decimal"
                  id={"purchase-price-#{release.id}"}
                  label="Preço (R$)"
                  placeholder="199,90"
                />
                <.input
                  field={
                    Map.get(@purchase_forms, release.id, to_form(%{}, as: :purchase))[:retailer]
                  }
                  id={"purchase-retailer-#{release.id}"}
                  label="Varejista"
                />
                <.input
                  field={
                    Map.get(@purchase_forms, release.id, to_form(%{}, as: :purchase))[
                      :purchased_at
                    ]
                  }
                  type="datetime-local"
                  id={"purchase-at-#{release.id}"}
                  label="Comprado em"
                />
                <button class="btn btn-primary sm:col-span-2" type="submit">Salvar</button>
              </.form>
            </details>
            <%= if data.veto do %>
              <button
                class="btn btn-ghost btn-sm text-error"
                phx-click="undo_veto"
                phx-value-id={data.veto.id}
              >Desfazer veto</button>
            <% else %>
              <details>
                <summary class="btn btn-ghost btn-sm cursor-pointer text-error">Vetar</summary>
                <.form
                  for={Map.get(@veto_forms, release.id, to_form(%{}, as: :veto))}
                  id={"veto-form-#{release.id}"}
                  phx-submit="save_veto"
                  class="mt-4 flex gap-2 rounded-xl border border-base-content/10 bg-base-200 p-4"
                >
                  <input type="hidden" name="release_id" value={release.id} />
                  <.input
                    field={Map.get(@veto_forms, release.id, to_form(%{}, as: :veto))[:reason]}
                    id={"veto-reason-#{release.id}"}
                    label="Motivo"
                  />
                  <button class="btn btn-outline btn-error self-end" type="submit">Confirmar</button>
                </.form>
              </details>
            <% end %>
          </div>
        </article>
      <% end %>
      <div :if={@release_data == []} class="py-8 text-sm text-base-content/60">Sem versões</div>
    </section>
  </div>
</Layouts.app>
