<Layouts.app flash={@flash}>
  <div class="mx-auto max-w-6xl space-y-8">
    <.page_header
      eyebrow="Jogo"
      title={@game.title}
      description="Fatos para decidir quando e como comprar."
    >
      <:actions>
        <.link navigate={~p"/catalogo"} class="btn btn-ghost">Voltar ao catálogo</.link>
      </:actions>
    </.page_header>

    <div class="flex flex-wrap gap-2">
      <.status_chip label={enum_label(@game.availability)} tone="primary" />
      <.status_chip
        :if={@game.estimated_duration_minutes}
        label={"#{@game.estimated_duration_minutes} min"}
      />
      <.status_chip :if={@game.pace} label={enum_label(@game.pace)} />
      <.status_chip :if={@game.play_mode} label={enum_label(@game.play_mode)} />
    </div>

    <.section_card title="Minha entrada">
      <div :if={@entry} class="mb-5 flex flex-wrap gap-3 text-sm">
        <.status_chip
          label={"intenção: #{enum_label(@entry.purchase_intent || :none)}"}
          tone="secondary"
        />
        <.status_chip label={"estado: #{enum_label(@entry.play_state || :unplayed)}"} />
        <span :if={@entry.target_price_cents} class="font-semibold">Alvo: {money(
          @entry.target_price_cents,
          @entry.currency
        )}</span>
        <.link href="/biblioteca" class="link link-primary">Editar na biblioteca</.link>
      </div>
      <.form
        for={@entry_form}
        id="entry-form"
        phx-submit="save_entry"
        class="grid gap-4 sm:grid-cols-3"
      >
        <.input
          field={@entry_form[:purchase_intent]}
          type="select"
          label="Intenção"
          options={[
            {"Nenhuma", :none},
            {"Interessado", :interested},
            {"Quero", :want},
            {"Planejado", :planned},
            {"Pré-venda", :preordered}
          ]}
        />
        <.input
          field={@entry_form[:play_state]}
          type="select"
          label="Estado"
          options={[
            {"Não jogado", :unplayed},
            {"Jogando", :playing},
            {"Pausado", :paused},
            {"Terminado", :finished},
            {"Abandonado", :abandoned}
          ]}
        />
        <.money_input field={@entry_form[:target_price_cents]} label="Preço alvo (R$)" />
        <button id="save-entry-button" class="btn btn-primary sm:col-span-3" type="submit">Salvar intenção</button>
      </.form>
    </.section_card>

    <div id="releases" class="grid gap-6 xl:grid-cols-2">
      <%= for release <- @game.releases do %>
        <% veto = Library.get_veto_for_release(@user, release.id) %>
        <% observations = Purchasing.list_price_observations(@user, release.id) %>
        <% latest = List.first(observations) %>
        <.section_card
          title={release.edition || "Edição padrão"}
          class={veto && "border-error/50"}
        >
          <div class="flex flex-wrap items-center gap-2 text-sm">
            <.platform_badge platform={release.platform} />
            <.media_badge :if={release.physical_available} media={:physical} />
            <.media_badge :if={release.digital_available} media={:digital} />
            <.media_badge :if={release.physical_is_key_card} media={:key_card} />
            <span :if={release.release_date} class="text-base-content/60">{date_pt_br(
              release.release_date
            )}</span>
            <.status_chip :if={veto} label="vetada" tone="error" />
          </div>
          <p :if={veto} class="mt-3 text-sm text-error">
            {veto.reason || "Sem motivo informado"}
          </p>
          <div
            :if={latest && @entry && @entry.target_price_cents}
            class="mt-4 rounded-xl bg-base-200 p-3 text-sm"
          >
            Última observação: <strong>{money(latest.price_cents, latest.currency)}</strong>
            <span :if={latest.price_cents <= @entry.target_price_cents} class="text-success">· abaixo do alvo</span>
            <span :if={latest.price_cents > @entry.target_price_cents} class="text-warning">· acima do alvo</span>
          </div>
          <div class="mt-5 space-y-3">
            <h3 class="font-bold">Observações de preço</h3>
            <.empty_state :if={observations == []} title="Nenhuma observação" />
            <%= for observation <- observations do %>
              <.dated_value
                value={observation.price_cents}
                currency={observation.currency}
                observed_at={DateTime.to_date(observation.observed_at)}
                stale={Purchasing.stale?(observation, DateTime.utc_now())}
              />
            <% end %>
          </div>
          <.form
            for={Map.get(@observation_forms, release.id, to_form(%{}, as: :observation))}
            id={"observation-form-#{release.id}"}
            phx-submit="save_observation"
            class="mt-5 grid gap-3 sm:grid-cols-2"
          >
            <input type="hidden" name="release_id" value={release.id} />
            <.input
              field={
                Map.get(@observation_forms, release.id, to_form(%{}, as: :observation))[:format]
              }
              type="select"
              id={"observation-format-#{release.id}"}
              label="Formato"
              options={[{"Físico", :physical}, {"Digital", :digital}]}
            />
            <.input
              field={
                Map.get(@observation_forms, release.id, to_form(%{}, as: :observation))[
                  :price_cents
                ]
              }
              type="text"
              inputmode="decimal"
              id={"observation-price-#{release.id}"}
              label="Preço (R$)"
              placeholder="199,90"
            />
            <.input
              field={
                Map.get(@observation_forms, release.id, to_form(%{}, as: :observation))[:currency]
              }
              id={"observation-currency-#{release.id}"}
              label="Moeda"
              value="BRL"
            />
            <.input
              field={
                Map.get(@observation_forms, release.id, to_form(%{}, as: :observation))[:source]
              }
              id={"observation-source-#{release.id}"}
              label="Fonte"
              placeholder="eShop ou loja"
            />
            <.input
              field={
                Map.get(@observation_forms, release.id, to_form(%{}, as: :observation))[
                  :observed_at
                ]
              }
              type="datetime-local"
              id={"observation-at-#{release.id}"}
              label="Observado em"
              value={
                DateTime.to_naive(DateTime.utc_now())
                |> NaiveDateTime.to_string()
                |> String.slice(0, 16)
              }
            />
            <button class="btn btn-secondary sm:col-span-2" type="submit">Registrar observação</button>
          </.form>
          <.form
            for={Map.get(@purchase_forms, release.id, to_form(%{}, as: :purchase))}
            id={"purchase-form-#{release.id}"}
            phx-submit="save_purchase"
            class="mt-5 grid gap-3 sm:grid-cols-2"
          >
            <input type="hidden" name="release_id" value={release.id} />
            <.input
              field={Map.get(@purchase_forms, release.id, to_form(%{}, as: :purchase))[:format]}
              type="select"
              id={"purchase-format-#{release.id}"}
              label="Compra em"
              options={[{"Físico", :physical}, {"Digital", :digital}]}
            />
            <.input
              field={
                Map.get(@purchase_forms, release.id, to_form(%{}, as: :purchase))[:price_cents]
              }
              type="text"
              inputmode="decimal"
              id={"purchase-price-#{release.id}"}
              label="Preço (R$)"
              placeholder="199,90"
            />
            <.input
              field={Map.get(@purchase_forms, release.id, to_form(%{}, as: :purchase))[:retailer]}
              id={"purchase-retailer-#{release.id}"}
              label="Varejista"
            />
            <.input
              field={
                Map.get(@purchase_forms, release.id, to_form(%{}, as: :purchase))[:purchased_at]
              }
              type="datetime-local"
              id={"purchase-at-#{release.id}"}
              label="Comprado em"
              value={
                DateTime.to_naive(DateTime.utc_now())
                |> NaiveDateTime.to_string()
                |> String.slice(0, 16)
              }
            />
            <button class="btn btn-primary sm:col-span-2" type="submit">Registrar compra e posse</button>
          </.form>
          <%= if veto do %>
            <button
              class="btn btn-ghost mt-4 text-error"
              phx-click="undo_veto"
              phx-value-id={veto.id}
            >Desfazer veto</button>
          <% else %>
            <.form
              for={Map.get(@veto_forms, release.id, to_form(%{}, as: :veto))}
              id={"veto-form-#{release.id}"}
              phx-submit="save_veto"
              class="mt-5 flex gap-2"
            >
              <input type="hidden" name="release_id" value={release.id} />
              <.input
                field={Map.get(@veto_forms, release.id, to_form(%{}, as: :veto))[:reason]}
                id={"veto-reason-#{release.id}"}
                label="Motivo do veto"
              />
              <button class="btn btn-outline btn-error self-end" type="submit">Vetar versão</button>
            </.form>
          <% end %>
        </.section_card>
      <% end %>
    </div>
  </div>
</Layouts.app>
