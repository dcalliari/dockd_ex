<Layouts.app flash={@flash} current="Planejador">
  <div class="space-y-8">
    <.page_header title="Planejador" />
    <section
      id="planner-money"
      class="grid grid-cols-2 gap-x-6 gap-y-5 border-y border-base-content/10 py-5 sm:grid-cols-4"
    >
      <div class="col-span-2 sm:col-span-1">
        <p class="text-xs text-base-content/60">Livre para gastar</p><p class="mt-1 text-2xl font-black tabular-nums">
          {money(@summary.money.free_cents, @summary.money.currency)}
        </p>
      </div>
      <div>
        <p class="text-xs text-base-content/60">Reservado</p><p class="mt-1 font-bold tabular-nums">
          {money(@summary.money.reserved_cents, @summary.money.currency)}
        </p>
      </div>
      <div>
        <p class="text-xs text-base-content/60">Este mês</p><p class="mt-1 font-bold tabular-nums">
          {money(@summary.money.spent_month_cents, @summary.money.currency)}
        </p>
      </div>
    </section>
    <div
      :if={@summary.money.free_cents < 0}
      id="planner-money-alert"
      class="border border-error/40 bg-error/10 p-4 text-sm"
      role="alert"
    >
      <strong>Saldo livre negativo.</strong>
      As reservas superam o saldo disponível em {money(
        abs(@summary.money.free_cents),
        @summary.money.currency
      )}. Revise uma reserva antes de comprar.
    </div>
    <section
      :if={@summary.recommendation}
      id="planner-recommendation"
      class="rounded-2xl border border-primary/30 bg-primary/10 p-5 sm:p-6"
      aria-labelledby="planner-recommendation-title"
    >
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="max-w-3xl">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-primary">
            Próximo jogo sugerido
          </p>
          <h2 id="planner-recommendation-title" class="mt-2 text-2xl font-black">
            {@summary.recommendation.game.title}
          </h2>
          <p class="mt-3 leading-7 text-base-content/75">{@summary.recommendation.reason}</p>
        </div>
        <.link
          navigate={"/jogos/#{@summary.recommendation.game.id}"}
          id="recommendation-game"
          class="btn btn-primary"
        >
          Ver jogo
        </.link>
      </div>
    </section>
    <div class="grid gap-8 lg:grid-cols-[1.2fr_.8fr]">
      <section>
        <h2 class="mb-4 text-xl font-bold">Próximos lançamentos</h2><div
          id="planner-calendar"
          class="divide-y divide-base-content/10"
        >
          <%= for item <- @summary.calendar do %>
            <.link
              navigate={"/jogos/#{item.game.id}"}
              id={"release-#{item.release.id}"}
              class="flex items-center gap-4 py-3 transition hover:text-primary"
            >
              <div class="w-28 shrink-0 text-sm">
                <time class="font-semibold">{Planner.release_date_label(item.release.release_date)}</time>
                <span class="mt-1 block text-xs text-base-content/60">{enum_label(
                  item.recommendation
                )}</span>
              </div><.game_cover
                title={item.game.title}
                cover_url={item.game.cover_url}
                class="w-12 shrink-0"
              /><span class="min-w-0 flex-1 truncate font-semibold">{item.game.title}</span>
              <span
                :if={item.reserved_cents > 0}
                class="shrink-0 text-xs font-semibold text-primary"
              >
                Reservado {money(item.reserved_cents, @summary.money.currency)}
              </span>
            </.link>
          <% end %>
          <.empty_state
            :if={@summary.calendar == []}
            title={@summary.calendar_empty_reason}
            description="Uma versão só entra no calendário quando o catálogo informa uma data de lançamento."
          >
            <:action>
              <.link navigate="/catalogo" class="btn btn-ghost">Ver catálogo</.link>
            </:action>
          </.empty_state>
        </div>
      </section>
      <section id="planner-backlog" class="border-l border-base-content/10 pl-6">
        <h2 class="text-xl font-bold">Backlog</h2><.link
          navigate="/biblioteca"
          class="mt-2 inline-flex items-baseline gap-2 hover:text-primary"
        ><span class="text-3xl font-black">{length(@summary.backlog)}</span><span class="text-sm text-base-content/60">no backlog</span></.link><ul class="mt-5 divide-y divide-base-content/10">
          <%= for item <- Enum.take(@summary.backlog, 5) do %>
            <li>
              <.link
                navigate={"/jogos/#{item.game.id}"}
                class="block py-3 font-semibold hover:text-primary"
              >{item.game.title}</.link>
            </li>
          <% end %>
        </ul>
      </section>
    </div>
    <section id="planner-decisions" class="space-y-4">
      <div>
        <h2 class="text-xl font-bold">Decisões de compra</h2>
        <p class="mt-1 text-sm text-base-content/60">
          A última observação é datada; nunca é tratada como preço atual.
        </p>
      </div>
      <div class="divide-y divide-base-content/10">
        <%= for item <- @summary.opportunities do %>
          <article id={"purchase-opportunity-#{item.release.id}"} class="py-4">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <.link navigate={"/jogos/#{item.game.id}"} class="font-bold hover:text-primary">
                  {item.game.title}
                </.link>
                <p class="text-sm text-base-content/60">
                  {enum_label(item.release.platform)} · {if item.release.release_date,
                    do: Planner.release_date_label(item.release.release_date),
                    else: "Sem data de lançamento"}
                </p>
              </div>
              <p class={[
                "font-bold",
                item.verdict == :buy && "text-success",
                item.verdict == :wait && "text-warning",
                item.verdict == :record_price && "text-base-content/70"
              ]}>
                {item.verdict_label}
              </p>
            </div>
            <p :if={item.entry.target_price_cents} class="mt-2 text-sm">
              Alvo: {money(item.entry.target_price_cents, item.entry.currency)}
            </p>
            <div :if={item.observation} class="mt-2 text-sm">
              Observado em {date_pt_br(DateTime.to_date(item.observation.observed_at))}:
              <strong>{money(item.observation.price_cents, item.observation.currency)}</strong>
              <span :if={item.observation_stale?} class="text-error">· desatualizado</span>
            </div>
            <p class="mt-1 text-sm text-base-content/70">{item.verdict_reason}</p>
          </article>
        <% end %>
        <.empty_state
          :if={@summary.opportunities == []}
          title="Nenhum desejo lançado ou sem data"
          description="Desejos com versão futura aparecem no calendário."
        />
      </div>
    </section>
  </div>
</Layouts.app>
