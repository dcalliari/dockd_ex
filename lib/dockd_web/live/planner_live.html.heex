<Layouts.app flash={@flash} current="Planejador">
  <div id="planner" class="space-y-9">
    <section id="planner-money" aria-label="Carteira">
      <%= if @balance_present? do %>
        <.link
          navigate="/carteira"
          id="planner-money-link"
          class="planner-equation group"
        >
          <div class="planner-money-part">
            <span>Saldo</span>
            <strong>{money(@summary.money.balance_cents, @summary.money.currency)}</strong>
          </div>
          <span class="planner-equation-mark" aria-hidden="true">−</span>
          <div class="planner-money-part">
            <span>Reservado</span>
            <strong>{money(@summary.money.reserved_cents, @summary.money.currency)}</strong>
          </div>
          <span class="planner-equation-mark" aria-hidden="true">=</span>
          <div class="planner-money-part planner-money-free">
            <span>Livre</span>
            <strong class={@summary.money.free_cents < 0 && "text-error"}>
              {money(@summary.money.free_cents, @summary.money.currency)}
            </strong>
          </div>
        </.link>
      <% else %>
        <.link
          navigate="/carteira"
          id="planner-wallet-action"
          class="planner-wallet-empty"
        >
          <span>Carteira</span>
          <strong>Informar saldo</strong>
        </.link>
      <% end %>
    </section>

    <section id="planner-calendar">
      <div class="planner-section-head">
        <h2>Próximos</h2>
        <.link navigate="/catalogo" class="text-xs font-bold text-primary">Descobrir</.link>
      </div>
      <div class="divide-y divide-base-content/10">
        <%= for item <- @summary.calendar do %>
          <.link
            navigate={"/jogos/#{item.game.id}?from=planner"}
            id={"release-#{item.release.id}"}
            class="planner-release-row group"
          >
            <.game_cover
              title={item.game.title}
              cover_url={item.game.cover_url}
              class="w-12 shrink-0 sm:w-14"
            />
            <span class="min-w-0 flex-1">
              <strong class="block truncate">{item.game.title}</strong>
              <span class="mt-1 block text-xs text-base-content/70">
                {Planner.release_date_label(item.release.release_date)} · {enum_label(
                  item.release.platform
                )}
              </span>
            </span>
            <span class="planner-verdict">{enum_label(item.recommendation)}</span>
          </.link>
        <% end %>
        <div :if={@summary.calendar == []} class="planner-empty-row">
          <span>Sem datas</span>
          <.link navigate="/catalogo" class="text-xs font-bold text-primary">Descobrir</.link>
        </div>
      </div>
    </section>

    <section :if={@decision_groups != []} id="planner-decisions">
      <div class="planner-section-head">
        <h2>Compras</h2>
        <.link navigate="/biblioteca?tab=want" class="text-xs font-bold text-primary">Ver todos</.link>
      </div>
      <div class="grid gap-8 lg:grid-cols-3">
        <%= for group <- @decision_groups do %>
          <section id={"planner-#{group.key}"} class="planner-decision-group">
            <h3>{group.label}<span>{length(group.items)}</span></h3>
            <div class="divide-y divide-base-content/10">
              <%= for item <- Enum.take(group.items, 4) do %>
                <.link
                  navigate={"/jogos/#{item.game.id}?from=planner"}
                  id={"purchase-opportunity-#{item.release.id}"}
                  class="planner-purchase-row group"
                >
                  <.game_cover
                    title={item.game.title}
                    cover_url={item.game.cover_url}
                    class="w-10 shrink-0"
                  />
                  <span class="min-w-0">
                    <strong class="block truncate">{item.game.title}</strong>
                    <span class="mt-1 block truncate text-xs text-base-content/70">
                      {verdict_reason(item)}
                    </span>
                  </span>
                </.link>
              <% end %>
            </div>
          </section>
        <% end %>
      </div>
    </section>

    <section :if={@summary.recommendation} id="planner-recommendation">
      <div class="planner-section-head">
        <h2>Jogar hoje</h2>
      </div>
      <.link
        navigate={"/jogos/#{@summary.recommendation.game.id}?from=planner"}
        id="recommendation-game"
        class="planner-recommendation group"
      >
        <.game_cover
          title={@summary.recommendation.game.title}
          cover_url={@summary.recommendation.game.cover_url}
          class="w-16 shrink-0 sm:w-20"
        />
        <span class="min-w-0 flex-1">
          <strong class="block text-lg">{@summary.recommendation.game.title}</strong>
          <span class="mt-1 block text-xs text-base-content/70">
            {recommendation_reason(@summary.recommendation)}
          </span>
        </span>
        <span class="text-xs font-bold text-primary">Começar</span>
      </.link>
    </section>

    <section id="planner-backlog" class="border-t border-base-content/10 pt-5">
      <.link navigate="/biblioteca" class="inline-flex items-baseline gap-3 group">
        <span class="display text-4xl font-black">{length(@summary.backlog)}</span>
        <span class="text-sm font-semibold text-base-content/70 group-hover:text-primary">Backlog</span>
      </.link>
    </section>
  </div>
</Layouts.app>
