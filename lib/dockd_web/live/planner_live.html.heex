<Layouts.app flash={@flash} current="Planejador">
  <div class="space-y-10">
    <.page_header title="Planejador" />

    <section id="planner-money" class="dockd-money-hero">
      <div class="dockd-money-primary">
        <p class="dockd-meta">Livre para gastar</p>
        <%= if @summary.money.balance_cents == 0 and @summary.money.reserved_cents == 0 do %>
          <p class="mt-2 text-2xl font-bold">Saldo não informado</p>
        <% else %>
          <p class="dockd-value mt-2 text-3xl font-bold sm:text-4xl">
            {money(@summary.money.free_cents, @summary.money.currency)}
          </p>
        <% end %>
      </div>
      <div>
        <p class="dockd-meta">Reservado</p>
        <p class="dockd-value mt-2 font-bold">
          <%= if @summary.money.reserved_cents == 0 do %>
            Nenhuma reserva
          <% else %>
            {money(@summary.money.reserved_cents, @summary.money.currency)}
          <% end %>
        </p>
      </div>
      <div>
        <p class="dockd-meta">Este mês</p>
        <p class="dockd-value mt-2 font-bold">
          <%= if @summary.money.spent_month_cents == 0 do %>
            Nenhum gasto
          <% else %>
            {money(@summary.money.spent_month_cents, @summary.money.currency)}
          <% end %>
        </p>
      </div>
    </section>

    <div
      :if={@summary.money.free_cents < 0}
      id="planner-money-alert"
      class="border-l-3 border-error bg-error/10 p-4 text-sm"
      role="alert"
    >
      <strong>Saldo livre negativo.</strong>
      As reservas superam o saldo disponível em {money(
        abs(@summary.money.free_cents),
        @summary.money.currency
      )}.
    </div>

    <section
      :if={@summary.recommendation}
      id="planner-recommendation"
      class="dockd-recommendation grid gap-4 sm:grid-cols-[5rem_1fr_auto] sm:items-center"
      aria-labelledby="planner-recommendation-title"
    >
      <.game_cover
        title={@summary.recommendation.game.title}
        cover_url={@summary.recommendation.game.cover_url}
        class="w-20 sm:w-20"
      />
      <div>
        <h2 id="planner-recommendation-title" class="text-xl font-black">Próximo jogo</h2>
        <p class="mt-1 font-bold">{@summary.recommendation.game.title}</p>
        <p class="dockd-note mt-2">{recommendation_reason(@summary.recommendation.reason)}</p>
      </div>
      <.link
        navigate={"/jogos/#{@summary.recommendation.game.id}"}
        id="recommendation-game"
        class="dockd-button dockd-button-primary"
      >Ver jogo</.link>
    </section>

    <div class="grid gap-10 lg:grid-cols-[1.25fr_.75fr]">
      <section id="planner-calendar" class="dockd-section">
        <h2 class="dockd-section-title">Próximos lançamentos</h2>
        <div class="mt-4 divide-y divide-base-content/10">
          <%= for item <- @summary.calendar do %>
            <.link
              navigate={"/jogos/#{item.game.id}"}
              id={"release-#{item.release.id}"}
              class="group flex items-center gap-4 py-4 transition-colors hover:text-primary"
            >
              <.game_cover
                title={item.game.title}
                cover_url={item.game.cover_url}
                class="w-14 shrink-0"
              />
              <div class="min-w-0 flex-1">
                <p class="font-bold">{item.game.title}</p>
                <p class="dockd-meta mt-1">
                  {release_date_label(item.release)} · {enum_label(item.recommendation)}
                </p>
              </div>
              <span
                :if={item.reserved_cents > 0}
                class="dockd-value shrink-0 text-xs font-bold text-primary"
              >
                {money(item.reserved_cents, @summary.money.currency)} reservado
              </span>
            </.link>
          <% end %>
          <.empty_state :if={@summary.calendar == []} title={@summary.calendar_empty_reason}>
            <:action>
              <.link
                navigate="/catalogo"
                class="dockd-meta font-bold underline underline-offset-2"
              >Ver catálogo</.link>
            </:action>
          </.empty_state>
        </div>
      </section>

      <section id="planner-backlog" class="dockd-section">
        <div class="flex items-baseline justify-between gap-3">
          <h2 class="dockd-section-title">Backlog</h2>
          <.link navigate="/biblioteca" class="dockd-meta font-bold underline underline-offset-2">Biblioteca</.link>
        </div>
        <div class="mt-4">
          <p class="dockd-value text-3xl font-bold">{length(@summary.backlog)}</p>
          <p class="dockd-meta mt-1">jogos aguardando</p>
        </div>
        <ul class="mt-5 divide-y divide-base-content/10">
          <%= for item <- Enum.take(@summary.backlog, 5) do %>
            <li>
              <.link
                navigate={"/jogos/#{item.game.id}"}
                class="flex items-center gap-3 py-3 font-bold hover:text-primary"
              >
                <.game_cover
                  title={item.game.title}
                  cover_url={item.game.cover_url}
                  class="w-10 shrink-0"
                />
                <span class="min-w-0 truncate">{item.game.title}</span>
              </.link>
            </li>
          <% end %>
        </ul>
        <.empty_state :if={@summary.backlog == []} title="Nenhum jogo no backlog" />
      </section>
    </div>

    <section id="planner-decisions" class="dockd-section">
      <h2 class="dockd-section-title">Decisões de compra</h2>
      <div class="mt-4 divide-y divide-base-content/10">
        <%= for item <- @summary.opportunities do %>
          <article
            id={"purchase-opportunity-#{item.release.id}"}
            class="grid gap-4 py-5 sm:grid-cols-[4rem_1fr]"
          >
            <.game_cover title={item.game.title} cover_url={item.game.cover_url} class="w-16" />
            <div>
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                  <.link navigate={"/jogos/#{item.game.id}"} class="font-bold hover:text-primary">{item.game.title}</.link>
                  <p class="dockd-meta mt-1">
                    {enum_label(item.release.platform)} · {if item.release.release_date,
                      do: release_date_label(item.release),
                      else: "Sem data de lançamento"}
                  </p>
                </div>
                <p class={[
                  "font-bold",
                  item.verdict == :buy && "text-success",
                  item.verdict == :wait && "text-warning",
                  item.verdict == :record_price && "text-base-content/70"
                ]}>
                  {item.verdict_label}
                </p>
              </div>
              <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm">
                <span :if={item.entry.target_price_cents}>Alvo:
                <strong class="dockd-value">{money(
                  item.entry.target_price_cents,
                  item.entry.currency
                )}</strong></span>
                <span :if={item.observation}>Observado em {date_pt_br(
                  DateTime.to_date(item.observation.observed_at)
                )}:
                <strong class="dockd-value">{money(
                  item.observation.price_cents,
                  item.observation.currency
                )}</strong></span>
                <span :if={item.observation_stale?} class="text-error">desatualizado</span>
              </div>
              <p class="dockd-note mt-2">{recommendation_reason(item.verdict_reason)}</p>
            </div>
          </article>
        <% end %>
        <.empty_state :if={@summary.opportunities == []} title="Nenhuma decisão para agora" />
      </div>
    </section>
  </div>
</Layouts.app>
